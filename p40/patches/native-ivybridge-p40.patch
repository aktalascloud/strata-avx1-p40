+ }
+ if(value===undefined)value=key.replace(/\btokens\/s\b|\btok\/s\b|\bt\/s\b/g,"ток/с").replace(/\bMB\/s\b/g,"МБ/с").replace(/\btokens\b/g,"ток.").replace(/\bMiB\b/g,"МиБ").replace(/\bGiB\b/g,"ГиБ").replace(/\bms\b/g,"мс");
+ value=value.replace(/\bGB\b/g,"ГБ").replace(/\bMB\/s\b/g,"МБ/с");
