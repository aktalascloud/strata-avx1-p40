index 0000000000000000000000000000000000000000..3d28f93d165ca49e159a74979ca475e3c3e15439
--- /dev/null
+++ b/tests/cuda/pascallama_mmq_screen.cpp
@@ -0,0 +1,182 @@
+// Local Pascal MMQ screen derived from upstream prefill_mmq_kquant_test (MIT).
+// Covers full pascallama J96/unroll with current IQ3_S/IQ4_NL and Q2_0/Q8_0 types.
+#include "strata/prefill/moe_mmq.hpp"
+
+#include "ggml.h"
+
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <numeric>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace {
+namespace mmq = strata::prefill::mmq;
+
+void ck(cudaError_t e, const char* what) {
+    if (e != cudaSuccess) throw std::runtime_error(std::string(what) + ": " + cudaGetErrorString(e));
+}
+
+struct Dev {
+    void* p = nullptr;
+    explicit Dev(size_t n) { ck(cudaMalloc(&p, n), "cudaMalloc"); }
+    ~Dev() { cudaFree(p); }
+    Dev(const Dev&) = delete;
+    Dev& operator=(const Dev&) = delete;
+};
+
+std::vector<uint8_t> make_matrix(ggml_type t, int64_t rows, int64_t cols, int expert, int trial) {
+    const auto* tr = ggml_get_type_traits(t);
+    if (tr == nullptr || tr->to_float == nullptr) throw std::runtime_error("no reference dequantizer");
+    const size_t rb = ggml_row_size(t, cols);
+    std::vector<uint8_t> out((size_t) rows * rb);
+    std::vector<float> row((size_t) cols);
+    for (int64_t r = 0; r < rows; ++r) {
+        for (int64_t k = 0; k < cols; ++k) {
+            const int code = (int) ((k * 37 + r * 19 + expert * 23 + trial * 11) % 101) - 50;
+            row[(size_t) k] = 0.025f * std::sin(0.013f * (float) (k + 1) + 0.17f * (float) r + 0.31f * (float) expert) +
+                              0.0015f * (float) code;
+        }
+        if (tr->from_float_ref != nullptr) tr->from_float_ref(row.data(), out.data() + (size_t) r * rb, cols);
+        else {
+            if (t != GGML_TYPE_IQ3_S) throw std::runtime_error("unsupported synthetic quant");
+            const size_t bs = ggml_type_size(t), blocks = rb / bs;
+            for (size_t block = 0; block < blocks; ++block) {
+                uint8_t* dst = out.data() + (size_t) r * rb + block * bs;
+                for (size_t k = 0; k < bs; ++k) dst[k] = (uint8_t) ((k * 37 + block * 19 + r * 11 + expert * 23 + trial * 7) & 255);
+                dst[0] = 0; dst[1] = 0x24; // finite positive fp16 block scale
+            }
+        }
+    }
+    return out;
+}
+
+std::vector<float> make_x(int rows, int64_t cols, int trial) {
+    std::vector<float> x((size_t) rows * (size_t) cols);
+    for (int r = 0; r < rows; ++r)
+        for (int64_t k = 0; k < cols; ++k)
+            x[(size_t) r * (size_t) cols + (size_t) k] =
+                0.45f * std::sin(0.009f * (float) (k + 1) + 0.23f * (float) r + 0.07f * (float) trial) +
+                0.17f * std::cos(0.021f * (float) (k + 3) - 0.19f * (float) r) +
+                0.002f * (float) (((k * 7 + r * 13 + trial * 5) % 19) - 9);
+    std::fill(x.end() - cols, x.end(), 0.0f);   // an all-zero row: exactly zero out
+    return x;
+}
+
+std::vector<int32_t> perm(int n, int shift, bool reverse) {
+    std::vector<int32_t> p((size_t) n);
+    for (int i = 0; i < n; ++i) p[(size_t) i] = (int32_t) (((reverse ? n - 1 - i : i) + shift) % n);
+    return p;
+}
+
+// one grouped product: experts side by side at one stride (a zeroed tail after them, as prefill.cpp stages them)
+void product(mmq::Context& ctx, cudaStream_t s, const char* name, ggml_type t, int64_t out_rows, int64_t cols,
+             const std::vector<int>& counts, int trial) {
+    if (!mmq::supported((int) t)) throw std::runtime_error(std::string(name) + ": not covered by this build");
+    const int n = (int) counts.size(), rows = std::accumulate(counts.begin(), counts.end(), 0);
+    std::vector<int32_t> bounds((size_t) n + 1, 0);
+    for (int e = 0; e < n; ++e) bounds[(size_t) e + 1] = bounds[(size_t) e] + counts[(size_t) e];
+    const auto src = perm(rows, trial + 1, false), dst = perm(rows, trial + 2, true);
+    const std::vector<float> x = make_x(rows, cols, trial);
+    const size_t eb = mmq::matrix_bytes((int) t, out_rows, cols);
+    if (eb != (size_t) out_rows * ggml_row_size(t, cols)) throw std::runtime_error(std::string(name) + ": matrix_bytes");
+    std::vector<std::vector<uint8_t>> ws;
+    std::vector<uint8_t> w((size_t) n * eb + 4096, 0);
+    for (int e = 0; e < n; ++e) {
+        ws.push_back(make_matrix(t, out_rows, cols, e, trial));
+        std::copy(ws.back().begin(), ws.back().end(), w.begin() + (ptrdiff_t) ((size_t) e * eb));
+    }
+    Dev dx(x.size() * 4), dsrc((size_t) rows * 4), ddst((size_t) rows * 4), db(bounds.size() * 4), dw(w.size()),
+        dxq(mmq::q8_bytes(rows, cols)), dy((size_t) rows * (size_t) out_rows * 4);
+    ck(cudaMemcpy(dx.p, x.data(), x.size() * 4, cudaMemcpyHostToDevice), "x");
+    ck(cudaMemcpy(dsrc.p, src.data(), src.size() * 4, cudaMemcpyHostToDevice), "src");
+    ck(cudaMemcpy(ddst.p, dst.data(), dst.size() * 4, cudaMemcpyHostToDevice), "dst");
+    ck(cudaMemcpy(db.p, bounds.data(), bounds.size() * 4, cudaMemcpyHostToDevice), "bounds");
+    ck(cudaMemcpy(dw.p, w.data(), w.size(), cudaMemcpyHostToDevice), "w");
+    ck(cudaMemset(dy.p, 0xff, (size_t) rows * (size_t) out_rows * 4), "sentinel");
+    // the copies and the sentinel above run on the legacy stream, which a non-blocking stream does not wait for: a
+    // pageable cudaMemcpy/cudaMemset can still be in flight when the kernels start (a 128-SM 4090 caught it)
+    ck(cudaDeviceSynchronize(), "inputs");
+    mmq::quantize((const float*) dx.p, (const int32_t*) dsrc.p, dxq.p, (int) t, cols, cols, rows, s);
+    mmq::Product p;
+    p.w = dw.p; p.type = (int) t; p.w_rows = out_rows; p.w_cols = cols; p.expert_bytes = eb; p.n = n;
+    p.xq = dxq.p; p.bounds = (const int32_t*) db.p; p.ids = (const int32_t*) ddst.p; p.total_rows = rows;
+    p.max_rows = *std::max_element(counts.begin(), counts.end()); p.dst = (float*) dy.p; p.ld_dst = out_rows;
+    ctx.run(p, s);
+    ck(cudaGetLastError(), "launch");
+    ck(cudaStreamSynchronize(s), "sync");
+    std::vector<float> got((size_t) rows * (size_t) out_rows);
+    ck(cudaMemcpy(got.data(), dy.p, got.size() * 4, cudaMemcpyDeviceToHost), "y");
+
+    const auto* tr = ggml_get_type_traits(t);
+    std::vector<float> ref(got.size(), 0.0f), wd((size_t) out_rows * (size_t) cols);
+    for (int e = 0; e < n; ++e) {
+        const size_t rb = ggml_row_size(t, cols);
+        for (int64_t o = 0; o < out_rows; ++o)
+            tr->to_float(ws[(size_t) e].data() + (size_t) o * rb, wd.data() + (size_t) o * (size_t) cols, cols);
+        for (int r = bounds[(size_t) e]; r < bounds[(size_t) e + 1]; ++r) {
+            const float* xr = x.data() + (size_t) src[(size_t) r] * (size_t) cols;
+            for (int64_t o = 0; o < out_rows; ++o) {
+                double acc = 0;
+                const float* wr = wd.data() + (size_t) o * (size_t) cols;
+                for (int64_t k = 0; k < cols; ++k) acc += (double) wr[k] * xr[k];
+                ref[(size_t) dst[(size_t) r] * (size_t) out_rows + (size_t) o] = (float) acc;
+            }
+        }
+    }
+    double err2 = 0, ref2 = 0, max_abs = 0, zero_max = 0;
+    for (size_t i = 0; i < got.size(); ++i) {
+        if (!std::isfinite(got[i])) throw std::runtime_error(std::string(name) + ": unwritten or non-finite output");
+        const double d = (double) got[i] - ref[i];
+        err2 += d * d; ref2 += (double) ref[i] * ref[i]; max_abs = std::max(max_abs, std::fabs(d));
+    }
+    for (int r = 0; r < rows; ++r)
+        if (src[(size_t) r] == rows - 1)   // the zero row
+            for (int64_t o = 0; o < out_rows; ++o)
+                zero_max = std::max(zero_max, (double) std::fabs(got[(size_t) dst[(size_t) r] * (size_t) out_rows + (size_t) o]));
+    const double rms = std::sqrt(ref2 / (double) ref.size()), rel = std::sqrt(err2 / (double) ref.size()) / rms;
+    std::printf("%-22s rows %2d experts %d  ref_rms %.4g  rel_l2 %.5f  max/rms %.4f  zero row %.3g\n", name, rows, n, rms,
+                rel, max_abs / rms, zero_max);
+    if (rel > 0.04 || max_abs / rms > 0.35 || zero_max > std::max(1e-5, 1e-4 * rms))
+        throw std::runtime_error(std::string(name) + ": outside the screen");
+}
+}  // namespace
+
+int main() {
+    try {
+        cudaDeviceProp prop{};
+        if(cudaGetDeviceProperties(&prop,0)!=cudaSuccess || prop.major!=6 || prop.minor!=1){std::puts("SKIP: real sm_61 required");return 77;}
+        if (!mmq::built()) { std::printf("no MMQ in this build\n"); return 1; }
+        // Reference IQ quantizers/dequantizers require their lookup tables.
+        // This is test setup; leave production quantization and error bounds unchanged.
+        for (ggml_type t : {GGML_TYPE_IQ3_S, GGML_TYPE_IQ4_NL, GGML_TYPE_Q2_0, GGML_TYPE_Q8_0})
+            ggml_quantize_init(t);
+        cudaStream_t s = nullptr;
+        ck(cudaStreamCreateWithFlags(&s, cudaStreamNonBlocking), "stream");
+        {
+            mmq::Context ctx;
+            const std::vector<std::vector<int>> batches{{1,3,3},{4,1,2},{17},{63},{96},{129}};
+            int trial = 0;
+            for (const auto& counts : batches) {
+                const std::string tag = "-" + std::to_string(trial);
+                product(ctx,s,("IQ3_S"+tag).c_str(),GGML_TYPE_IQ3_S,128,256,counts,trial);
+                product(ctx,s,("IQ4_NL"+tag).c_str(),GGML_TYPE_IQ4_NL,130,256,counts,trial+3);
+                product(ctx,s,("Q2_0"+tag).c_str(),GGML_TYPE_Q2_0,128,256,counts,trial+7);
+                product(ctx,s,("Q8_0"+tag).c_str(),GGML_TYPE_Q8_0,130,256,counts,trial+11);
+                ++trial;
+            }
+        }
+        ck(cudaStreamDestroy(s), "destroy");
+        ggml_quantize_free();
+        std::printf("Pascallama sm_61 MMQ numerical screen passed\n");
+        return 0;
+    } catch (const std::exception& e) {
+        std::fprintf(stderr, "Pascallama sm_61 MMQ numerical screen failed: %s\n", e.what());
+        return 1;
+    }
+}
diff --git a/tests/cuda/prefill_group_scratch_parity.cpp b/tests/cuda/prefill_group_scratch_parity.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..97bfd7068bb500f4edcb9829a810feded3279f2f
--- /dev/null
+++ b/tests/cuda/prefill_group_scratch_parity.cpp
@@ -0,0 +1,92 @@
+// Numerical-only qualification of PR4039's absolute bounds and compact per-group destination.
+// Uses the existing MIT Pascal fixture's data generators; no model, speed measurement or tolerances.
+#define main original_pascal_screen_main
+#include "pascallama_mmq_screen.cpp"
+#undef main
+#include <cstring>
+
+namespace {
+std::vector<uint8_t> weights(ggml_type t, int64_t nr, int64_t nc, int e) {
+    if (ggml_get_type_traits(t)->from_float_ref || t == GGML_TYPE_IQ3_S)
+        return make_matrix(t, nr, nc, e, 7);
+    const size_t rb = ggml_row_size(t, nc), bs = ggml_type_size(t);
+    std::vector<uint8_t> out(size_t(nr) * rb);
+    for (int64_t r = 0; r < nr; ++r)
+        for (size_t b = 0; b < rb / bs; ++b) {
+            auto* p = out.data() + size_t(r) * rb + b * bs;
+            for (size_t k = 0; k < bs; ++k) p[k] = uint8_t(k * 37 + b * 19 + r * 11 + e * 23);
+            p[0] = 0; p[1] = 0x24;
+        }
+    return out;
+}
+void scratch_case(mmq::Context& ctx, cudaStream_t s, ggml_type t, int64_t nr, int64_t nc,
+                  const std::vector<int>& counts) {
+    const int ne = int(counts.size()), rows = std::accumulate(counts.begin(), counts.end(), 0);
+    std::vector<int32_t> bounds(size_t(ne) + 1), ids(static_cast<size_t>(rows));
+    for (int e = 0; e < ne; ++e) bounds[size_t(e) + 1] = bounds[size_t(e)] + counts[size_t(e)];
+    std::iota(ids.begin(), ids.end(), 0);
+    const size_t eb = mmq::matrix_bytes(int(t), nr, nc);
+    std::vector<uint8_t> host(size_t(ne) * eb + 4096);
+    for (int e = 0; e < ne; ++e) {
+        auto w = weights(t, nr, nc, e);
+        std::copy(w.begin(), w.end(), host.begin() + ptrdiff_t(size_t(e) * eb));
+    }
+    auto x = make_x(rows, nc, 11);
+    const size_t bytes = size_t(rows) * size_t(nr) * 4;
+    const int cap = *std::max_element(counts.begin(), counts.end());
+    Dev dw(host.size()), dx(x.size()*4), dxq(mmq::q8_bytes(rows,nc)), db(bounds.size()*4), di(ids.size()*4),
+        dy(bytes), compact(size_t(cap)*size_t(nr)*4 + 256), joined(bytes);
+    ck(cudaMemcpy(dw.p,host.data(),host.size(),cudaMemcpyHostToDevice),"weights");
+    ck(cudaMemcpy(dx.p,x.data(),x.size()*4,cudaMemcpyHostToDevice),"input");
+    ck(cudaMemcpy(db.p,bounds.data(),bounds.size()*4,cudaMemcpyHostToDevice),"bounds");
+    ck(cudaMemcpy(di.p,ids.data(),ids.size()*4,cudaMemcpyHostToDevice),"ids");
+    ck(cudaDeviceSynchronize(),"input ordering");
+    mmq::quantize(static_cast<float*>(dx.p),nullptr,dxq.p,int(t),nc,nc,rows,s);
+    mmq::Product p; p.w=dw.p;p.type=int(t);p.w_rows=nr;p.w_cols=nc;p.expert_bytes=eb;p.n=ne;
+    p.xq=dxq.p;p.bounds=static_cast<int32_t*>(db.p);p.ids=static_cast<int32_t*>(di.p);
+    p.total_rows=rows;p.max_rows=cap;p.dst=static_cast<float*>(dy.p);p.ld_dst=nr;
+    ctx.run(p,s);ck(cudaStreamSynchronize(s),"whole product");
+    std::vector<float> reference(size_t(rows)*size_t(nr)), got(reference.size());
+    ck(cudaMemcpy(reference.data(),dy.p,bytes,cudaMemcpyDeviceToHost),"reference");
+    auto run=[&] {
+        for(int e=0;e<ne;++e) {
+            if(!counts[size_t(e)])continue;
+            auto part=p;part.w=static_cast<uint8_t*>(dw.p)+size_t(e)*eb;part.n=1;
+            part.bounds=static_cast<int32_t*>(db.p)+e;part.max_rows=counts[size_t(e)];
+            const auto shift=uint64_t(bounds[size_t(e)])*uint64_t(nr)*4;
+            part.dst=reinterpret_cast<float*>(reinterpret_cast<uintptr_t>(compact.p)-shift);
+            ctx.run(part,s);
+            ck(cudaMemcpyAsync(static_cast<uint8_t*>(joined.p)+shift,compact.p,
+                size_t(counts[size_t(e)])*size_t(nr)*4,cudaMemcpyDeviceToDevice,s),"compact result");
+        }
+    };
+    run();ck(cudaStreamSynchronize(s),"compact product");
+    ck(cudaMemcpy(got.data(),joined.p,bytes,cudaMemcpyDeviceToHost),"compact readback");
+    if(std::memcmp(reference.data(),got.data(),bytes))throw std::runtime_error("compact product differs from whole");
+    cudaGraph_t graph=nullptr;cudaGraphExec_t exec=nullptr;
+    ck(cudaStreamBeginCapture(s,cudaStreamCaptureModeGlobal),"capture");run();
+    ck(cudaStreamEndCapture(s,&graph),"end capture");ck(cudaGraphInstantiate(&exec,graph,0),"instantiate");
+    ck(cudaGraphLaunch(exec,s),"launch graph");ck(cudaStreamSynchronize(s),"graph sync");
+    ck(cudaMemcpy(got.data(),joined.p,bytes,cudaMemcpyDeviceToHost),"graph readback");
+    if(std::memcmp(reference.data(),got.data(),bytes))throw std::runtime_error("compact graph differs from whole");
+    cudaGraphExecDestroy(exec);cudaGraphDestroy(graph);
+    std::printf("PASS compact/whole/graph type%d shape%lldx%lld rows%d\n",int(t),(long long)nr,(long long)nc,rows);
+}
+}
+int main() {
+    try {
+        cudaDeviceProp prop{};ck(cudaGetDeviceProperties(&prop,0),"device");
+        if(prop.major!=6||prop.minor!=1)return 77;
+        cudaStream_t s=nullptr;ck(cudaStreamCreateWithFlags(&s,cudaStreamNonBlocking),"stream");
+        { mmq::Context ctx;
+          for(auto t:{GGML_TYPE_IQ3_S,GGML_TYPE_IQ3_XXS,GGML_TYPE_IQ2_S,GGML_TYPE_IQ4_XS,GGML_TYPE_IQ4_NL,GGML_TYPE_Q2_0,GGML_TYPE_Q8_0}) {
+            ggml_quantize_init(t);
+            for(const auto& counts:std::vector<std::vector<int>>{{0,1,3,7},{3,0,1,3}}) {
+                scratch_case(ctx,s,t,1280,2560,counts);
+                if(640 % ggml_blck_size(t)==0) scratch_case(ctx,s,t,2560,640,counts);
+            }
+          }
+        }
+        ck(cudaStreamDestroy(s),"destroy");ggml_quantize_free();return 0;
+    } catch(const std::exception& e){std::fprintf(stderr,"FAIL scratch parity: %s\n",e.what());return 1;}
+}
