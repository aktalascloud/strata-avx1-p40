+const originals=new WeakMap(), attributes=new WeakMap();let observer=null;
+const normalize=s=>s.replace(/\s+/g," ").trim();
+function translate(source){
+ if(lang==="en")return source;
+ const key=normalize(source);let value=RU[key];
+ if(value===undefined){
+  const patterns=[
+   [/^last: (\d+) tokens? at (.+) tok\/s$/,(_,n,speed)=>`последний запрос: ${n} ток., ${speed} ток/с`],
+   [/^([\d\s,.]+) experts cached$/,(_,n)=>`Экспертов в кэше: ${n}`],
+   [/^of ([\d.,]+) W limit$/,(_,n)=>`лимит ${n} Вт`],
+   [/^to GPU (.+)$/,(_,n)=>`в GPU ${n}`],
+   [/^write (.+)$/,(_,n)=>`запись ${n}`],
+   [/^(\d+) cores · (\d+) threads$/,(_,a,b)=>`${a} ядер · ${b} потоков`],
+   [/^(.+), (\d+) threads$/,(_,a,n)=>`${a}, ${n} потоков`],
+   [/^MTP drafts up to ([\d\s.,]+)(?: tokens?)?$/,(_,n)=>`MTP: до ${n.trim()} черновых токенов`],
+   [/^(\d+)-bit \(Hadamard-rotated\), all in VRAM$/,(_,n)=>`${n} бит, преобразование Адамара; целиком в VRAM`],
+   [/^(.+) runs on this PC\. Nothing leaves it\.$/,(_,model)=>`${model} работает на этом компьютере. Данные остаются здесь.`],
+   [/^You · (.*)$/,(_,time)=>`Вы · ${time}`],
+   [/^Thought for ([\d.,]+) s$/,(_,n)=>`Рассуждение: ${n} с`],
+   [/^(\d+) tool calls?$/,(_,n)=>`Вызовы инструментов: ${n}`],
+   [/^(\d+) requests?$/,(_,n)=>`Запросов: ${n}`],
+   [/^(\d+) files?$/,(_,n)=>`Файлов: ${n}`]
