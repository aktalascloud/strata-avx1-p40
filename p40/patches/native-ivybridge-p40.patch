+GREEDY_PENALTIES = ("presence_penalty", "frequency_penalty", "repetition_penalty")
+PENALTY_NEUTRAL = {"presence_penalty": 0.0, "frequency_penalty": 0.0, "repetition_penalty": 1.0}
