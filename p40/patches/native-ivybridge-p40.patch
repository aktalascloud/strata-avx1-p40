+ if(observer)observer.disconnect();
+ const walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);let node;
+ while(node=walker.nextNode()){
+  if(skip(node.parentElement)||!node.data.trim())continue;
+  if(!originals.has(node))originals.set(node,node.data);
+  const next=translate(originals.get(node));if(node.data!==next)node.data=next;
+ }
+ const all=root.querySelectorAll?root.querySelectorAll("[title],[aria-label],[placeholder]"):[];
+ for(const el of all){
+  if(skip(el,true))continue;let data=attributes.get(el);if(!data){data={};attributes.set(el,data)}
+  for(const key of ["title","aria-label","placeholder"]){
+   if(!el.hasAttribute(key))continue;if(!(key in data))data[key]=el.getAttribute(key);
+   const next=translate(data[key]);if(el.getAttribute(key)!==next)el.setAttribute(key,next);
+  }
+ }
+ document.documentElement.lang=lang;
+ if(observer)observer.observe(document.body,{subtree:true,childList:true,characterData:true,attributes:true,attributeFilter:["title","aria-label","placeholder"]});
+}
+function setup(){
+ const header=document.querySelector(".st-header,header");
+ if(header&&!document.getElementById("strata-language")){
+  const select=document.createElement("select");select.id="strata-language";select.className="st-language";select.setAttribute("aria-label","Language");
+  select.innerHTML='<option value="ru">Русский</option><option value="en">English</option>';select.value=lang;
+  select.onchange=()=>{lang=select.value;localStorage.setItem("strata.language",JSON.stringify(lang));apply();window.dispatchEvent(new Event("strata-language-change"))};header.appendChild(select);
+ }
+ observer=new MutationObserver(mutations=>{
+  let changed=false;
+  for(const mutation of mutations){
+   const el=mutation.target.nodeType===3?mutation.target.parentElement:mutation.target;
+   if(skip(el))continue;
+   if(mutation.type==="characterData")originals.delete(mutation.target);
+   if(mutation.type==="attributes"){const data=attributes.get(mutation.target);if(data)delete data[mutation.attributeName]}
+   changed=true;
+  }
+  if(changed)apply();
+ });
+ apply();
+}
+window.StrataI18n={t:translate,apply,language:()=>lang,keys:Object.keys(RU)};
+if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",setup,{once:true});else setup();
+})();
