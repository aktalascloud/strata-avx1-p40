diff --git a/cmake/strata_ivybridge_o3.cmake b/cmake/strata_ivybridge_o3.cmake
new file mode 100644
index 00000000..9db8b4c9
--- /dev/null
+++ b/cmake/strata_ivybridge_o3.cmake
@@ -0,0 +1,22 @@
+# Local profile: genuine Clang O3 with an Ivy Bridge baseline. Preserve runtime-dispatched wider kernels.
+option(STRATA_IVYBRIDGE_O3 "Local Windows Clang O3/Ivy Bridge profile" OFF)
+if(STRATA_IVYBRIDGE_O3)
+  if(NOT MSVC OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
+    message(FATAL_ERROR "STRATA_IVYBRIDGE_O3 requires clang-cl with the MSVC ABI")
+  endif()
+  set(_ivy_wide /clang:-mavx2 /clang:-mfma /clang:-mf16c /clang:-fno-vectorize /clang:-fno-slp-vectorize)
+  foreach(_src src/kernels/cpu/expert.cpp src/kernels/cpu/iq_avx512.cpp src/kernels/cpu/nvfp4_avx512.cpp src/kernels/cpu/tq_avx512.cpp)
+    set_property(SOURCE ${_src} APPEND PROPERTY COMPILE_OPTIONS ${_ivy_wide}
+      /clang:-mavx512f /clang:-mavx512bw /clang:-mavx512vl /clang:-mavx512dq /clang:-mavx512vnni /clang:-mavx512vbmi)
+  endforeach()
+  # New upstream exact IQ512 rows require these only in this guarded wide-ISA TU.
+  set_property(SOURCE src/kernels/cpu/iq_avx512.cpp APPEND PROPERTY COMPILE_OPTIONS
+    /clang:-mavx512vpopcntdq /clang:-mbmi2)
+  foreach(_src src/kernels/cpu/q2_avx2.cpp src/kernels/cpu/iq_avx2.cpp src/kernels/cpu/kq_avx2.cpp src/kernels/cpu/nvfp4_avx2.cpp src/kernels/cpu/tq_avx2.cpp)
+    set_property(SOURCE ${_src} APPEND PROPERTY COMPILE_OPTIONS ${_ivy_wide})
+  endforeach()
+  foreach(_src src/kernels/cpu/q2_avx1.cpp src/kernels/cpu/iq_avx1.cpp src/kernels/cpu/kq_avx1.cpp)
+    set_property(SOURCE ${_src} APPEND PROPERTY COMPILE_OPTIONS /clang:-mavx /clang:-mno-avx2 /clang:-mno-fma /clang:-mno-f16c)
+  endforeach()
+  message(STATUS "Local CPU profile: Clang -O3, Ivy Bridge tuning, AVX baseline, guarded wide kernels retained")
+endif()
diff --git a/cmake/strata_pascallama_overlay.cmake b/cmake/strata_pascallama_overlay.cmake
new file mode 100644
index 00000000..753ef5f9
--- /dev/null
+++ b/cmake/strata_pascallama_overlay.cmake
@@ -0,0 +1,23 @@
+# The complete upstream pascallama patch is applied only to a private build-tree copy of pinned ggml.
+function(strata_pascallama_overlay original destination patch git)
+  if(NOT EXISTS "${patch}" OR NOT EXISTS "${git}")
+    message(FATAL_ERROR "Verified pascallama patch/private Git are required")
+  endif()
+  file(MAKE_DIRECTORY "${destination}")
+  file(COPY "${original}/ggml" DESTINATION "${destination}" FILES_MATCHING PATTERN "*.h" PATTERN "*.cuh" PATTERN "*.cu")
+  foreach(_name mmq-config-pascal-dp4a.cuh mmq-vec-dot.cuh)
+    set(_file "${destination}/ggml/src/ggml-cuda/${_name}")
+    file(READ "${original}/ggml/src/ggml-cuda/${_name}" _text)
+    string(REPLACE "\r\n" "\n" _text "${_text}")
+    file(CONFIGURE OUTPUT "${_file}" CONTENT "${_text}" @ONLY NEWLINE_STYLE UNIX)
+  endforeach()
+  execute_process(COMMAND "${git}" -C "${destination}" apply --check "${patch}" RESULT_VARIABLE _check OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
+  if(NOT _check EQUAL 0)
+    message(FATAL_ERROR "Pascallama patch does not match pinned ggml: ${_stdout}${_stderr}")
+  endif()
+  execute_process(COMMAND "${git}" -C "${destination}" apply "${patch}" RESULT_VARIABLE _apply OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
+  if(NOT _apply EQUAL 0)
+    message(FATAL_ERROR "Pascallama private overlay failed: ${_stdout}${_stderr}")
+  endif()
+  message(STATUS "Experimental P40 MMQ: complete pascallama J96 config and nine DP4A unroll hints; pinned dependency untouched")
+endfunction()
diff --git a/docs/DETAILS.md b/docs/DETAILS.md
index 43538ddc..8049a569 100644
--- a/docs/DETAILS.md
+++ b/docs/DETAILS.md
@@ -1332,3 +1332,37 @@ mean KL from the stock model 0.063 nats (max 4.1), perplexity +15% on code, +2.3
   the original 2,682 in 46 s. Speed: 4K IQ2_XS 465 prompt / 78.7 output tokens/s against 467 / 78.3 for the original.
 - UD-Q4_K_XL on a 64 GB PC with a 12 GB RTX 5070: 7-8.5 tok/s, picks the same tokens as llama.cpp on the same file at 97.5-99% of the
   positions of short greedy answers and 90-91% after a 16K prompt ([UNSLOTH_Q4.md](UNSLOTH_Q4.md#quality-against-llamacpp-on-the-same-file)).
+
+## A faster engine start on Windows (on by default with CUDA: `STRATA_ARENA_PREFAULT`, `STRATA_DENSE_UPLOAD_THREADS`, `STRATA_EARLY_ARENA`)
+
+On Windows with an NVIDIA card, three changes shorten the engine's load. Each has a switch that restores the old way.
+Measured on an RTX 3090 24 GB, Core Ultra 9 285K, 95 GB DDR5-6800 and a PCIe 5 SSD reading 11.2 GiB/s, with IQ3_S at a
+262,144-token context: the engine alone was ready in 8.72 s instead of 15.94 s (medians of 8 + 8 starts, every start
+with the changes faster than every start without).
+
+- **The arena's pages are touched by several threads before it is pinned** (`STRATA_ARENA_PREFAULT`). Left to
+  `cudaHostRegister`, the first touch of the 46.8 GiB expert arena ran on one thread inside it, about 5 s; min(16,
+  hardware threads) threads take 0.5-0.7 s in most starts (1.1 s or 2.5 s with other programs busy).
+  `STRATA_ARENA_PREFAULT=0` leaves the first touch to `cudaHostRegister`;
+  `=N` sets the threads. Not used with large pages, a shared arena file, or an arena that is not pinned (integrated
+  GPU).
+- **The projection matrices are uploaded by 8 threads** (`STRATA_DENSE_UPLOAD_THREADS`). Windows does not read a mapped
+  file ahead, so one copy per matrix took its page faults 4 KiB at a time: 1.5 s for 2019 MiB. Eight threads, each
+  reading 8 MiB pieces into pinned buffers, take 0.3 s. `STRATA_DENSE_UPLOAD_THREADS=1` restores the single copy.
+  `STRATA_DENSE_CHECKSUM=1` prints a hash of the matrices as the GPU holds them, for checking that both ways give the
+  same bytes (they do: the same hash with 1 and 8 threads).
+- **The expert arena is loaded from the start** (`STRATA_EARLY_ARENA`). Before, it was read only after the dense
+  weights, the draft layer and the output head. Now a thread pins it and reads the experts into it while those load;
+  the arena is ready about 2 s sooner. The other loads then share the drive with it and take longer (done at about
+  6.5 s instead of 2.7 s here); the bytes read are the same, only their order changes, so on a slower drive the gain
+  may be smaller. It starts only when the free RAM covers the arena plus the RAM floor
+  (`--conversation-cache-min-free-mib`, at least 8 GiB); otherwise the start is as before, with the line
+  `STRATA_EARLY_ARENA: expert read not started: ...` saying why. Not used with two GPUs (a layer split, also one
+  that `--split-skip-if-fits` later drops, or remote experts), a pin cap, a shared arena file, `--mmap-experts`, `STRATA_PIN_BY_NEED=1` or `STRATA_DEFERRED_REGISTER=1`.
+  If the early read fails, the line `STRATA_EARLY_ARENA: the early arena is not used (...)` says why and the arena
+  loads as before. A load that fails before the arena is opened exits only once the early read has finished.
+  `STRATA_EARLY_ARENA=0` turns it off.
+
+The answers do not change: the expert arena's checksum (`STRATA_VERIFY_ARENA=1`) is the same with these on and off, and
+decode and prompt speed after loading were unchanged in the same runs. None of this is built for Linux, macOS, AMD
+(HIP) or Intel Arc (SYCL): there the start is as before.
