+# Local profile: genuine Clang O3 with an Ivy Bridge baseline. Preserve runtime-dispatched wider kernels.
+option(STRATA_IVYBRIDGE_O3 "Local Windows Clang O3/Ivy Bridge profile" OFF)
+if(STRATA_IVYBRIDGE_O3)
+  if(NOT MSVC OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
+    message(FATAL_ERROR "STRATA_IVYBRIDGE_O3 requires clang-cl with the MSVC ABI")
+  endif()
+  set(_ivy_wide /clang:-mavx2 /clang:-mfma /clang:-mf16c /clang:-fno-vectorize /clang:-fno-slp-vectorize)
+  foreach(_src src/kernels/cpu/expert.cpp src/kernels/cpu/iq_avx512.cpp src/kernels/cpu/nvfp4_avx512.cpp src/kernels/cpu/tq_avx512.cpp)
+    set_property(SOURCE ${_src} APPEND PROPERTY COMPILE_OPTIONS ${_ivy_wide}
+      /clang:-mavx512f /clang:-mavx512bw /clang:-mavx512vl /clang:-mavx512dq /clang:-mavx512vnni /clang:-mavx512vbmi)
+  endforeach()
+  foreach(_src src/kernels/cpu/q2_avx2.cpp src/kernels/cpu/iq_avx2.cpp src/kernels/cpu/kq_avx2.cpp src/kernels/cpu/nvfp4_avx2.cpp src/kernels/cpu/tq_avx2.cpp)
+    set_property(SOURCE ${_src} APPEND PROPERTY COMPILE_OPTIONS ${_ivy_wide})
+  endforeach()
+  foreach(_src src/kernels/cpu/q2_avx1.cpp src/kernels/cpu/iq_avx1.cpp src/kernels/cpu/kq_avx1.cpp)
+    set_property(SOURCE ${_src} APPEND PROPERTY COMPILE_OPTIONS /clang:-mavx /clang:-mno-avx2 /clang:-mno-fma /clang:-mno-f16c)
+  endforeach()
+  message(STATUS "Local CPU profile: Clang -O3, Ivy Bridge tuning, AVX baseline, guarded wide kernels retained")
+endif()
diff --git a/cmake/strata_pascallama_overlay.cmake b/cmake/strata_pascallama_overlay.cmake
new file mode 100644
--- /dev/null
+++ b/cmake/strata_pascallama_overlay.cmake
@@ -0,0 +1,23 @@
+# The complete upstream pascallama patch is applied only to a private build-tree copy of pinned ggml.
+function(strata_pascallama_overlay original destination patch git)
+  if(NOT EXISTS "${patch}" OR NOT EXISTS "${git}")
+    message(FATAL_ERROR "Verified pascallama patch/private Git are required")
+  endif()
+  file(MAKE_DIRECTORY "${destination}")
+  file(COPY "${original}/ggml" DESTINATION "${destination}" FILES_MATCHING PATTERN "*.h" PATTERN "*.cuh" PATTERN "*.cu")
+  foreach(_name mmq-config-pascal-dp4a.cuh mmq-vec-dot.cuh)
+    set(_file "${destination}/ggml/src/ggml-cuda/${_name}")
+    file(READ "${original}/ggml/src/ggml-cuda/${_name}" _text)
+    string(REPLACE "\r\n" "\n" _text "${_text}")
+    file(CONFIGURE OUTPUT "${_file}" CONTENT "${_text}" @ONLY NEWLINE_STYLE UNIX)
+  endforeach()
+  execute_process(COMMAND "${git}" -C "${destination}" apply --check "${patch}" RESULT_VARIABLE _check OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
+  if(NOT _check EQUAL 0)
+    message(FATAL_ERROR "Pascallama patch does not match pinned ggml: ${_stdout}${_stderr}")
+  endif()
+  execute_process(COMMAND "${git}" -C "${destination}" apply "${patch}" RESULT_VARIABLE _apply OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
+  if(NOT _apply EQUAL 0)
+    message(FATAL_ERROR "Pascallama private overlay failed: ${_stdout}${_stderr}")
+  endif()
+  message(STATUS "Experimental P40 MMQ: complete pascallama J96 config and nine DP4A unroll hints; pinned dependency untouched")
+endfunction()
diff --git a/tests/cuda/pascallama_mmq_screen.cpp b/tests/cuda/pascallama_mmq_screen.cpp
new file mode 100644
--- /dev/null
+++ b/tests/cuda/pascallama_mmq_screen.cpp
@@ -0,0 +1,182 @@
+// Local Pascal MMQ screen derived from upstream prefill_mmq_kquant_test (MIT).
+// Covers full pascallama J96/unroll with current IQ3_S/IQ4_NL and Q2_0/Q8_0 types.
+#include "strata/prefill/moe_mmq.hpp"
+
+#include "ggml.h"
+
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <numeric>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace {
+namespace mmq = strata::prefill::mmq;
+
+void ck(cudaError_t e, const char* what) {
+    if (e != cudaSuccess) throw std::runtime_error(std::string(what) + ": " + cudaGetErrorString(e));
+}
+
+struct Dev {
+    void* p = nullptr;
+    explicit Dev(size_t n) { ck(cudaMalloc(&p, n), "cudaMalloc"); }
+    ~Dev() { cudaFree(p); }
+    Dev(const Dev&) = delete;
+    Dev& operator=(const Dev&) = delete;
+};
+
+std::vector<uint8_t> make_matrix(ggml_type t, int64_t rows, int64_t cols, int expert, int trial) {
+    const auto* tr = ggml_get_type_traits(t);
+    if (tr == nullptr || tr->to_float == nullptr) throw std::runtime_error("no reference dequantizer");
+    const size_t rb = ggml_row_size(t, cols);
+    std::vector<uint8_t> out((size_t) rows * rb);
+    std::vector<float> row((size_t) cols);
+    for (int64_t r = 0; r < rows; ++r) {
+        for (int64_t k = 0; k < cols; ++k) {
+            const int code = (int) ((k * 37 + r * 19 + expert * 23 + trial * 11) % 101) - 50;
+            row[(size_t) k] = 0.025f * std::sin(0.013f * (float) (k + 1) + 0.17f * (float) r + 0.31f * (float) expert) +
+                              0.0015f * (float) code;
+        }
+        if (tr->from_float_ref != nullptr) tr->from_float_ref(row.data(), out.data() + (size_t) r * rb, cols);
+        else {
+            if (t != GGML_TYPE_IQ3_S) throw std::runtime_error("unsupported synthetic quant");
+            const size_t bs = ggml_type_size(t), blocks = rb / bs;
+            for (size_t block = 0; block < blocks; ++block) {
+                uint8_t* dst = out.data() + (size_t) r * rb + block * bs;
+                for (size_t k = 0; k < bs; ++k) dst[k] = (uint8_t) ((k * 37 + block * 19 + r * 11 + expert * 23 + trial * 7) & 255);
+                dst[0] = 0; dst[1] = 0x24; // finite positive fp16 block scale
+            }
+        }
+    }
+    return out;
+}
+
+std::vector<float> make_x(int rows, int64_t cols, int trial) {
+    std::vector<float> x((size_t) rows * (size_t) cols);
+    for (int r = 0; r < rows; ++r)
+        for (int64_t k = 0; k < cols; ++k)
+            x[(size_t) r * (size_t) cols + (size_t) k] =
+                0.45f * std::sin(0.009f * (float) (k + 1) + 0.23f * (float) r + 0.07f * (float) trial) +
+                0.17f * std::cos(0.021f * (float) (k + 3) - 0.19f * (float) r) +
+                0.002f * (float) (((k * 7 + r * 13 + trial * 5) % 19) - 9);
+    std::fill(x.end() - cols, x.end(), 0.0f);   // an all-zero row: exactly zero out
+    return x;
+}
+
+std::vector<int32_t> perm(int n, int shift, bool reverse) {
+    std::vector<int32_t> p((size_t) n);
+    for (int i = 0; i < n; ++i) p[(size_t) i] = (int32_t) (((reverse ? n - 1 - i : i) + shift) % n);
+    return p;
+}
+
+// one grouped product: experts side by side at one stride (a zeroed tail after them, as prefill.cpp stages them)
+void product(mmq::Context& ctx, cudaStream_t s, const char* name, ggml_type t, int64_t out_rows, int64_t cols,
+             const std::vector<int>& counts, int trial) {
+    if (!mmq::supported((int) t)) throw std::runtime_error(std::string(name) + ": not covered by this build");
+    const int n = (int) counts.size(), rows = std::accumulate(counts.begin(), counts.end(), 0);
+    std::vector<int32_t> bounds((size_t) n + 1, 0);
+    for (int e = 0; e < n; ++e) bounds[(size_t) e + 1] = bounds[(size_t) e] + counts[(size_t) e];
+    const auto src = perm(rows, trial + 1, false), dst = perm(rows, trial + 2, true);
+    const std::vector<float> x = make_x(rows, cols, trial);
+    const size_t eb = mmq::matrix_bytes((int) t, out_rows, cols);
+    if (eb != (size_t) out_rows * ggml_row_size(t, cols)) throw std::runtime_error(std::string(name) + ": matrix_bytes");
+    std::vector<std::vector<uint8_t>> ws;
+    std::vector<uint8_t> w((size_t) n * eb + 4096, 0);
+    for (int e = 0; e < n; ++e) {
+        ws.push_back(make_matrix(t, out_rows, cols, e, trial));
+        std::copy(ws.back().begin(), ws.back().end(), w.begin() + (ptrdiff_t) ((size_t) e * eb));
+    }
+    Dev dx(x.size() * 4), dsrc((size_t) rows * 4), ddst((size_t) rows * 4), db(bounds.size() * 4), dw(w.size()),
+        dxq(mmq::q8_bytes(rows, cols)), dy((size_t) rows * (size_t) out_rows * 4);
+    ck(cudaMemcpy(dx.p, x.data(), x.size() * 4, cudaMemcpyHostToDevice), "x");
+    ck(cudaMemcpy(dsrc.p, src.data(), src.size() * 4, cudaMemcpyHostToDevice), "src");
+    ck(cudaMemcpy(ddst.p, dst.data(), dst.size() * 4, cudaMemcpyHostToDevice), "dst");
+    ck(cudaMemcpy(db.p, bounds.data(), bounds.size() * 4, cudaMemcpyHostToDevice), "bounds");
+    ck(cudaMemcpy(dw.p, w.data(), w.size(), cudaMemcpyHostToDevice), "w");
+    ck(cudaMemset(dy.p, 0xff, (size_t) rows * (size_t) out_rows * 4), "sentinel");
+    // the copies and the sentinel above run on the legacy stream, which a non-blocking stream does not wait for: a
+    // pageable cudaMemcpy/cudaMemset can still be in flight when the kernels start (a 128-SM 4090 caught it)
+    ck(cudaDeviceSynchronize(), "inputs");
+    mmq::quantize((const float*) dx.p, (const int32_t*) dsrc.p, dxq.p, (int) t, cols, cols, rows, s);
+    mmq::Product p;
+    p.w = dw.p; p.type = (int) t; p.w_rows = out_rows; p.w_cols = cols; p.expert_bytes = eb; p.n = n;
+    p.xq = dxq.p; p.bounds = (const int32_t*) db.p; p.ids = (const int32_t*) ddst.p; p.total_rows = rows;
+    p.max_rows = *std::max_element(counts.begin(), counts.end()); p.dst = (float*) dy.p; p.ld_dst = out_rows;
+    ctx.run(p, s);
+    ck(cudaGetLastError(), "launch");
+    ck(cudaStreamSynchronize(s), "sync");
+    std::vector<float> got((size_t) rows * (size_t) out_rows);
+    ck(cudaMemcpy(got.data(), dy.p, got.size() * 4, cudaMemcpyDeviceToHost), "y");
+
+    const auto* tr = ggml_get_type_traits(t);
+    std::vector<float> ref(got.size(), 0.0f), wd((size_t) out_rows * (size_t) cols);
+    for (int e = 0; e < n; ++e) {
+        const size_t rb = ggml_row_size(t, cols);
+        for (int64_t o = 0; o < out_rows; ++o)
+            tr->to_float(ws[(size_t) e].data() + (size_t) o * rb, wd.data() + (size_t) o * (size_t) cols, cols);
+        for (int r = bounds[(size_t) e]; r < bounds[(size_t) e + 1]; ++r) {
+            const float* xr = x.data() + (size_t) src[(size_t) r] * (size_t) cols;
+            for (int64_t o = 0; o < out_rows; ++o) {
+                double acc = 0;
+                const float* wr = wd.data() + (size_t) o * (size_t) cols;
+                for (int64_t k = 0; k < cols; ++k) acc += (double) wr[k] * xr[k];
+                ref[(size_t) dst[(size_t) r] * (size_t) out_rows + (size_t) o] = (float) acc;
+            }
+        }
+    }
+    double err2 = 0, ref2 = 0, max_abs = 0, zero_max = 0;
+    for (size_t i = 0; i < got.size(); ++i) {
+        if (!std::isfinite(got[i])) throw std::runtime_error(std::string(name) + ": unwritten or non-finite output");
+        const double d = (double) got[i] - ref[i];
+        err2 += d * d; ref2 += (double) ref[i] * ref[i]; max_abs = std::max(max_abs, std::fabs(d));
+    }
+    for (int r = 0; r < rows; ++r)
+        if (src[(size_t) r] == rows - 1)   // the zero row
+            for (int64_t o = 0; o < out_rows; ++o)
+                zero_max = std::max(zero_max, (double) std::fabs(got[(size_t) dst[(size_t) r] * (size_t) out_rows + (size_t) o]));
+    const double rms = std::sqrt(ref2 / (double) ref.size()), rel = std::sqrt(err2 / (double) ref.size()) / rms;
+    std::printf("%-22s rows %2d experts %d  ref_rms %.4g  rel_l2 %.5f  max/rms %.4f  zero row %.3g\n", name, rows, n, rms,
+                rel, max_abs / rms, zero_max);
+    if (rel > 0.04 || max_abs / rms > 0.35 || zero_max > std::max(1e-5, 1e-4 * rms))
+        throw std::runtime_error(std::string(name) + ": outside the screen");
+}
+}  // namespace
+
+int main() {
+    try {
+        cudaDeviceProp prop{};
+        if(cudaGetDeviceProperties(&prop,0)!=cudaSuccess || prop.major!=6 || prop.minor!=1){std::puts("SKIP: real sm_61 required");return 77;}
+        if (!mmq::built()) { std::printf("no MMQ in this build\n"); return 1; }
+        // Reference IQ quantizers/dequantizers require their lookup tables.
+        // This is test setup; leave production quantization and error bounds unchanged.
+        for (ggml_type t : {GGML_TYPE_IQ3_S, GGML_TYPE_IQ4_NL, GGML_TYPE_Q2_0, GGML_TYPE_Q8_0})
+            ggml_quantize_init(t);
+        cudaStream_t s = nullptr;
+        ck(cudaStreamCreateWithFlags(&s, cudaStreamNonBlocking), "stream");
+        {
+            mmq::Context ctx;
+            const std::vector<std::vector<int>> batches{{1,3,3},{4,1,2},{17},{63},{96},{129}};
+            int trial = 0;
+            for (const auto& counts : batches) {
+                const std::string tag = "-" + std::to_string(trial);
+                product(ctx,s,("IQ3_S"+tag).c_str(),GGML_TYPE_IQ3_S,128,256,counts,trial);
+                product(ctx,s,("IQ4_NL"+tag).c_str(),GGML_TYPE_IQ4_NL,130,256,counts,trial+3);
+                product(ctx,s,("Q2_0"+tag).c_str(),GGML_TYPE_Q2_0,128,256,counts,trial+7);
+                product(ctx,s,("Q8_0"+tag).c_str(),GGML_TYPE_Q8_0,130,256,counts,trial+11);
+                ++trial;
+            }
+        }
+        ck(cudaStreamDestroy(s), "destroy");
+        ggml_quantize_free();
+        std::printf("Pascallama sm_61 MMQ numerical screen passed\n");
+        return 0;
+    } catch (const std::exception& e) {
+        std::fprintf(stderr, "Pascallama sm_61 MMQ numerical screen failed: %s\n", e.what());
+        return 1;
+    }
+}
diff --git a/tests/cuda/sm61_graph_parity.cu b/tests/cuda/sm61_graph_parity.cu
new file mode 100644
--- /dev/null
+++ b/tests/cuda/sm61_graph_parity.cu
@@ -0,0 +1,25 @@
+// Local P40 qualification. No model, no ISA/SM guard bypass; mutable-buffer CUDA Graph replay vs direct kernels.
+#include <cuda_runtime.h>
+#include <cstdio>
+#include <vector>
+__global__ void transform(const float* x,float* y,int n){int i=(int)(blockIdx.x*blockDim.x+threadIdx.x);if(i<n)y[i]=x[i]*2.0f+1.0f;}
+int main(){
+  cudaDeviceProp prop{};if(cudaGetDeviceProperties(&prop,0)!=cudaSuccess||prop.major!=6||prop.minor!=1){std::puts("SKIP: this qualification targets real sm_61");return 77;}
+  const int n=4096;float *x=nullptr,*a=nullptr,*b=nullptr;cudaStream_t stream=nullptr;
+  if(cudaMalloc(&x,n*sizeof(float))||cudaMalloc(&a,n*sizeof(float))||cudaMalloc(&b,n*sizeof(float))||cudaStreamCreate(&stream))return 1;
+  cudaGraph_t graph=nullptr;cudaGraphExec_t exec=nullptr;
+  if(cudaStreamBeginCapture(stream,cudaStreamCaptureModeGlobal)!=cudaSuccess)return 1;
+  transform<<<16,256,0,stream>>>(x,b,n);
+  if(cudaStreamEndCapture(stream,&graph)!=cudaSuccess||cudaGraphInstantiate(&exec,graph,nullptr,nullptr,0)!=cudaSuccess)return 1;
+  std::vector<float> input(n),direct(n),captured(n);
+  for(int trial=0;trial<4;++trial){
+    for(int i=0;i<n;++i)input[i]=(float)(i+trial*17)/32.0f;
+    if(cudaMemcpyAsync(x,input.data(),n*sizeof(float),cudaMemcpyHostToDevice,stream)!=cudaSuccess)return 1;
+    transform<<<16,256,0,stream>>>(x,a,n);
+    if(cudaGraphLaunch(exec,stream)!=cudaSuccess||cudaStreamSynchronize(stream)!=cudaSuccess)return 1;
+    if(cudaMemcpy(direct.data(),a,n*sizeof(float),cudaMemcpyDeviceToHost)!=cudaSuccess||cudaMemcpy(captured.data(),b,n*sizeof(float),cudaMemcpyDeviceToHost)!=cudaSuccess)return 1;
+    for(int i=0;i<n;++i)if(direct[i]!=captured[i]||captured[i]!=input[i]*2.0f+1.0f)return 1;
+  }
+  cudaGraphExecDestroy(exec);cudaGraphDestroy(graph);cudaStreamDestroy(stream);cudaFree(x);cudaFree(a);cudaFree(b);
+  std::printf("PASS: %s sm_61 CUDA Graph capture/replay, changed inputs, bitwise direct parity\n",prop.name);return 0;
+}
diff --git a/include/strata/platform/win_numa_arena.hpp b/include/strata/platform/win_numa_arena.hpp
new file mode 100644
--- /dev/null
+++ b/include/strata/platform/win_numa_arena.hpp
@@ -0,0 +1,94 @@
+// Windows-only NUMA preference for the existing pinned arena. No CPU affinity changes.
+#pragma once
+#include <cstdint>
+#include <cstdlib>
+#include <limits>
+#include <string>
+#include <vector>
+
+namespace strata::platform::win_numa {
+struct Node { int id; uint64_t free_bytes; bool has_cpu; };
+struct Decision { int node = -1; bool requested = false; std::string why; };
+inline Decision choose(const char* mode, const std::vector<Node>& nodes, int gpu_node, uint64_t bytes) {
+    Decision d;
+    if (mode == nullptr || *mode == '\0' || std::string(mode) == "off") return d;
+    d.requested = true;
+    int wanted = -1;
+    if (std::string(mode) == "gpu" || std::string(mode) == "auto") {
+        wanted = gpu_node;
+        if (wanted < 0) { d.why = "GPU host NUMA node unknown; ordinary allocation"; return d; }
+    } else {
+        unsigned value = 0;
+        for (const char* p = mode; *p; ++p) {
+            if (*p < '0' || *p > '9' || value > (65535u - unsigned(*p-'0')) / 10u) {
+                d.why = "invalid STRATA_WIN_NUMA_NODE (off, gpu or a node number); ordinary allocation"; return d;
+            }
+            value = value * 10 + unsigned(*p-'0');
+        }
+        wanted = int(value);
+    }
+    int count = 0; const Node* selected = nullptr;
+    for (const Node& n : nodes) { if (n.has_cpu) ++count; if (n.has_cpu && n.id == wanted) selected = &n; }
+    if (count < 2) { d.why = "fewer than two CPU NUMA nodes; ordinary allocation"; return d; }
+    if (selected == nullptr) { d.why = "requested NUMA node has no CPUs; ordinary allocation"; return d; }
+    constexpr uint64_t headroom = 4ull << 30;
+    if (bytes > selected->free_bytes || selected->free_bytes - bytes < headroom) {
+        d.why = "preferred NUMA node lacks arena plus 4 GiB headroom; ordinary allocation"; return d;
+    }
+    d.node = wanted;
+    d.why = "NUMA node " + std::to_string(wanted) + " preferred (Windows may fall back); CPU placement unchanged";
+    return d;
+}
+} // namespace strata::platform::win_numa
+
+#if defined(_WIN32)
+#include <windows.h>
+#include <psapi.h>
+namespace strata::platform::win_numa {
+inline Decision probe(const char* mode, int gpu_node, uint64_t bytes) {
+    if (mode == nullptr || *mode == '\0' || std::string(mode) == "off") return {};
+    ULONG highest = 0; std::vector<Node> nodes;
+    if (!GetNumaHighestNodeNumber(&highest) || highest > 1024) {
+        return {-1, true, "Windows NUMA topology unavailable; ordinary allocation"};
+    }
+    for (ULONG n = 0; n <= highest; ++n) {
+        GROUP_AFFINITY mask{}; ULONGLONG available = 0;
+        if (GetNumaNodeProcessorMaskEx(USHORT(n), &mask) && mask.Mask != 0 &&
+            GetNumaAvailableMemoryNodeEx(USHORT(n), &available)) nodes.push_back({int(n), available, true});
+    }
+    return choose(mode, nodes, gpu_node, bytes);
+}
+inline std::string placement(void* base, SIZE_T bytes, int preferred) {
+    if (base == nullptr || bytes == 0 || preferred < 0) return {};
+    constexpr SIZE_T page = 4096;
+    const SIZE_T pages = (bytes - 1) / page + 1;
+    const SIZE_T count = pages < 128 ? pages : 128;
+    PSAPI_WORKING_SET_EX_INFORMATION info[128]{};
+    for (SIZE_T i = 0; i < count; ++i) {
+        const SIZE_T index = count == 1 ? 0 : ((pages - 1) / (count - 1)) * i;
+        info[i].VirtualAddress = static_cast<unsigned char*>(base) + index * page;
+    }
+    if (!QueryWorkingSetEx(GetCurrentProcess(), info, DWORD(count * sizeof(info[0]))))
+        return "NUMA page sample unavailable (error " + std::to_string(GetLastError()) + ")";
+    unsigned local = 0, remote = 0, not_resident = 0;
+    for (SIZE_T i = 0; i < count; ++i) {
+        if (!info[i].VirtualAttributes.Valid) ++not_resident;
+        else if (int(info[i].VirtualAttributes.Node) == preferred) ++local;
+        else ++remote;
+    }
+    return "NUMA page sample local/remote/not-resident=" + std::to_string(local) + "/" +
+        std::to_string(remote) + "/" + std::to_string(not_resident);
+}
+inline void* allocate(SIZE_T bytes, DWORD flags, const Decision& d, std::string& report) {
+    if (d.node >= 0) {
+        void* p = VirtualAllocExNuma(GetCurrentProcess(), nullptr, bytes, flags, PAGE_READWRITE, DWORD(d.node));
+        if (p != nullptr) { report = d.why + "; " + placement(p, bytes, d.node); return p; }
+        const DWORD error = GetLastError();
+        report = "NUMA allocation refused (error " + std::to_string(error) + "); ordinary allocation";
+    } else if (d.requested) report = d.why;
+    void* p = VirtualAlloc(nullptr, bytes, flags, PAGE_READWRITE);
+    // Preserve the ordinary allocation's last error for the existing large-page diagnostic.
+    const DWORD error = GetLastError(); SetLastError(error); return p;
+}
+} // namespace strata::platform::win_numa
+#endif
diff --git a/tests/platform/windows_numa_arena_test.cpp b/tests/platform/windows_numa_arena_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/platform/windows_numa_arena_test.cpp
@@ -0,0 +1,49 @@
+#include "strata/platform/win_numa_arena.hpp"
+#include <cstdio>
+#include <cstring>
+using namespace strata::platform::win_numa;
+#define CHECK(x) do { ++cases; if (!(x)) { std::fprintf(stderr,"FAIL line %d: %s\n",__LINE__,#x); return 1; } } while(0)
+int main() {
+    int cases = 0;
+    const uint64_t gib = 1ull << 30;
+    const std::vector<Node> two{{0,128*gib,true},{3,128*gib,true}};
+    CHECK(!choose(nullptr,two,0,gib).requested);
+    CHECK(!choose("off",two,0,gib).requested);
+    CHECK(choose("gpu",two,3,gib).node==3);
+    CHECK(choose("auto",two,0,gib).node==0);
+    CHECK(choose("0",two,-1,gib).node==0);
+    CHECK(choose("3",two,-1,gib).node==3);
+    CHECK(choose("gpu",two,-1,gib).node<0);
+    CHECK(choose("1",two,0,gib).node<0);
+    CHECK(choose("3",{{0,128*gib,true},{3,128*gib,false}},0,gib).node<0);
+    CHECK(choose("0",{{0,128*gib,true}},0,gib).node<0);
+    CHECK(choose("0",two,0,125*gib).node<0);
+    CHECK(choose("0",two,0,124*gib).node==0);
+    CHECK(choose("0",two,0,~uint64_t(0)).node<0);
+    CHECK(choose("65536",two,0,gib).node<0);
+    CHECK(choose("99999999999999999999",two,0,gib).node<0);
+    CHECK(choose("-1",two,0,gib).node<0);
+    CHECK(choose(" 0",two,0,gib).node<0);
+    CHECK(choose("0x0",two,0,gib).node<0);
+    DWORD_PTR before=0,system=0,after=0,system_after=0;
+    CHECK(GetProcessAffinityMask(GetCurrentProcess(),&before,&system));
+    CHECK(!probe("off",-1,gib).requested);
+    // Small real Win32 API positive control. This does not claim a two-node host or enable production policy.
+    GROUP_AFFINITY mask{};
+    CHECK(GetNumaNodeProcessorMaskEx(0,&mask) && mask.Mask);
+    const SIZE_T bytes=2*1024*1024;
+    std::string note;
+    void* memory=allocate(bytes,MEM_COMMIT|MEM_RESERVE,Decision{0,true,"test node0 preferred"},note);
+    CHECK(memory!=nullptr);
+    std::memset(memory,0x5a,bytes);
+    const auto* data=static_cast<const unsigned char*>(memory);
+    bool intact=true; for(SIZE_T i=0;i<bytes;++i) if(data[i]!=0x5a){intact=false;break;}
+    CHECK(intact);
+    const std::string sample=placement(memory,bytes,0);
+    CHECK(sample.find("NUMA page sample local/remote/not-resident=")!=std::string::npos);
+    CHECK(VirtualFree(memory,0,MEM_RELEASE));
+    CHECK(GetProcessAffinityMask(GetCurrentProcess(),&after,&system_after));
+    CHECK(before==after && system==system_after);
+    std::printf("Windows NUMA arena: %d cases PASS; no CPU affinity changes; %s\n",cases,sample.c_str());
+    return 0;
+}
