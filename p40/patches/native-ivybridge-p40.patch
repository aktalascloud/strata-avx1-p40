+}
+function skip(el,attr=false){
+ if(!el)return true;
+ if(el.closest("script,style,[data-i18n-ignore]"))return true;
+ if(el.closest("button,select,label,option,.msg-error,.think-title,.meta-text,.st-msg__meta,.tool-call__label,.tool-call .st-badge"))return false;
+ if(attr&&el.matches("input,textarea"))return false;
+ return !!el.closest(".st-bubble,.thinking,pre,code,textarea,input,.msg-images,#attachments,.tool-call__pre,.tool-call__preview,.req-preview,.request-preview,[data-user-content]");
+}
