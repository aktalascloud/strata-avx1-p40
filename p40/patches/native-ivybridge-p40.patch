@@ -0,0 +1,182 @@
+// Local Pascal MMQ screen derived from upstream prefill_mmq_kquant_test (MIT).
+// Covers full pascallama J96/unroll with current IQ3_S/IQ4_NL and Q2_0/Q8_0 types.
+#include "strata/prefill/moe_mmq.hpp"
+
+#include "ggml.h"
+
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <numeric>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace {
+namespace mmq = strata::prefill::mmq;
+
+void ck(cudaError_t e, const char* what) {
+    if (e != cudaSuccess) throw std::runtime_error(std::string(what) + ": " + cudaGetErrorString(e));
+}
+
+struct Dev {
+    void* p = nullptr;
+    explicit Dev(size_t n) { ck(cudaMalloc(&p, n), "cudaMalloc"); }
+    ~Dev() { cudaFree(p); }
+    Dev(const Dev&) = delete;
+    Dev& operator=(const Dev&) = delete;
+};
+
+std::vector<uint8_t> make_matrix(ggml_type t, int64_t rows, int64_t cols, int expert, int trial) {
+    const auto* tr = ggml_get_type_traits(t);
+    if (tr == nullptr || tr->to_float == nullptr) throw std::runtime_error("no reference dequantizer");
+    const size_t rb = ggml_row_size(t, cols);
+    std::vector<uint8_t> out((size_t) rows * rb);
+    std::vector<float> row((size_t) cols);
+    for (int64_t r = 0; r < rows; ++r) {
+        for (int64_t k = 0; k < cols; ++k) {
+            const int code = (int) ((k * 37 + r * 19 + expert * 23 + trial * 11) % 101) - 50;
+            row[(size_t) k] = 0.025f * std::sin(0.013f * (float) (k + 1) + 0.17f * (float) r + 0.31f * (float) expert) +
+                              0.0015f * (float) code;
+        }
+        if (tr->from_float_ref != nullptr) tr->from_float_ref(row.data(), out.data() + (size_t) r * rb, cols);
+        else {
+            if (t != GGML_TYPE_IQ3_S) throw std::runtime_error("unsupported synthetic quant");
+            const size_t bs = ggml_type_size(t), blocks = rb / bs;
+            for (size_t block = 0; block < blocks; ++block) {
+                uint8_t* dst = out.data() + (size_t) r * rb + block * bs;
+                for (size_t k = 0; k < bs; ++k) dst[k] = (uint8_t) ((k * 37 + block * 19 + r * 11 + expert * 23 + trial * 7) & 255);
+                dst[0] = 0; dst[1] = 0x24; // finite positive fp16 block scale
+            }
+        }
+    }
+    return out;
+}
+
+std::vector<float> make_x(int rows, int64_t cols, int trial) {
+    std::vector<float> x((size_t) rows * (size_t) cols);
+    for (int r = 0; r < rows; ++r)
+        for (int64_t k = 0; k < cols; ++k)
+            x[(size_t) r * (size_t) cols + (size_t) k] =
+                0.45f * std::sin(0.009f * (float) (k + 1) + 0.23f * (float) r + 0.07f * (float) trial) +
+                0.17f * std::cos(0.021f * (float) (k + 3) - 0.19f * (float) r) +
+                0.002f * (float) (((k * 7 + r * 13 + trial * 5) % 19) - 9);
+    std::fill(x.end() - cols, x.end(), 0.0f);   // an all-zero row: exactly zero out
+    return x;
+}
+
+std::vector<int32_t> perm(int n, int shift, bool reverse) {
+    std::vector<int32_t> p((size_t) n);
+    for (int i = 0; i < n; ++i) p[(size_t) i] = (int32_t) (((reverse ? n - 1 - i : i) + shift) % n);
+    return p;
+}
+
+// one grouped product: experts side by side at one stride (a zeroed tail after them, as prefill.cpp stages them)
+void product(mmq::Context& ctx, cudaStream_t s, const char* name, ggml_type t, int64_t out_rows, int64_t cols,
+             const std::vector<int>& counts, int trial) {
+    if (!mmq::supported((int) t)) throw std::runtime_error(std::string(name) + ": not covered by this build");
+    const int n = (int) counts.size(), rows = std::accumulate(counts.begin(), counts.end(), 0);
+    std::vector<int32_t> bounds((size_t) n + 1, 0);
+    for (int e = 0; e < n; ++e) bounds[(size_t) e + 1] = bounds[(size_t) e] + counts[(size_t) e];
+    const auto src = perm(rows, trial + 1, false), dst = perm(rows, trial + 2, true);
+    const std::vector<float> x = make_x(rows, cols, trial);
+    const size_t eb = mmq::matrix_bytes((int) t, out_rows, cols);
+    if (eb != (size_t) out_rows * ggml_row_size(t, cols)) throw std::runtime_error(std::string(name) + ": matrix_bytes");
+    std::vector<std::vector<uint8_t>> ws;
+    std::vector<uint8_t> w((size_t) n * eb + 4096, 0);
+    for (int e = 0; e < n; ++e) {
+        ws.push_back(make_matrix(t, out_rows, cols, e, trial));
+        std::copy(ws.back().begin(), ws.back().end(), w.begin() + (ptrdiff_t) ((size_t) e * eb));
+    }
+    Dev dx(x.size() * 4), dsrc((size_t) rows * 4), ddst((size_t) rows * 4), db(bounds.size() * 4), dw(w.size()),
+        dxq(mmq::q8_bytes(rows, cols)), dy((size_t) rows * (size_t) out_rows * 4);
+    ck(cudaMemcpy(dx.p, x.data(), x.size() * 4, cudaMemcpyHostToDevice), "x");
+    ck(cudaMemcpy(dsrc.p, src.data(), src.size() * 4, cudaMemcpyHostToDevice), "src");
+    ck(cudaMemcpy(ddst.p, dst.data(), dst.size() * 4, cudaMemcpyHostToDevice), "dst");
+    ck(cudaMemcpy(db.p, bounds.data(), bounds.size() * 4, cudaMemcpyHostToDevice), "bounds");
+    ck(cudaMemcpy(dw.p, w.data(), w.size(), cudaMemcpyHostToDevice), "w");
+    ck(cudaMemset(dy.p, 0xff, (size_t) rows * (size_t) out_rows * 4), "sentinel");
+    // the copies and the sentinel above run on the legacy stream, which a non-blocking stream does not wait for: a
+    // pageable cudaMemcpy/cudaMemset can still be in flight when the kernels start (a 128-SM 4090 caught it)
+    ck(cudaDeviceSynchronize(), "inputs");
+    mmq::quantize((const float*) dx.p, (const int32_t*) dsrc.p, dxq.p, (int) t, cols, cols, rows, s);
+    mmq::Product p;
+    p.w = dw.p; p.type = (int) t; p.w_rows = out_rows; p.w_cols = cols; p.expert_bytes = eb; p.n = n;
+    p.xq = dxq.p; p.bounds = (const int32_t*) db.p; p.ids = (const int32_t*) ddst.p; p.total_rows = rows;
+    p.max_rows = *std::max_element(counts.begin(), counts.end()); p.dst = (float*) dy.p; p.ld_dst = out_rows;
+    ctx.run(p, s);
+    ck(cudaGetLastError(), "launch");
+    ck(cudaStreamSynchronize(s), "sync");
+    std::vector<float> got((size_t) rows * (size_t) out_rows);
+    ck(cudaMemcpy(got.data(), dy.p, got.size() * 4, cudaMemcpyDeviceToHost), "y");
+
+    const auto* tr = ggml_get_type_traits(t);
+    std::vector<float> ref(got.size(), 0.0f), wd((size_t) out_rows * (size_t) cols);
+    for (int e = 0; e < n; ++e) {
+        const size_t rb = ggml_row_size(t, cols);
+        for (int64_t o = 0; o < out_rows; ++o)
+            tr->to_float(ws[(size_t) e].data() + (size_t) o * rb, wd.data() + (size_t) o * (size_t) cols, cols);
+        for (int r = bounds[(size_t) e]; r < bounds[(size_t) e + 1]; ++r) {
+            const float* xr = x.data() + (size_t) src[(size_t) r] * (size_t) cols;
+            for (int64_t o = 0; o < out_rows; ++o) {
+                double acc = 0;
+                const float* wr = wd.data() + (size_t) o * (size_t) cols;
+                for (int64_t k = 0; k < cols; ++k) acc += (double) wr[k] * xr[k];
+                ref[(size_t) dst[(size_t) r] * (size_t) out_rows + (size_t) o] = (float) acc;
+            }
+        }
+    }
+    double err2 = 0, ref2 = 0, max_abs = 0, zero_max = 0;
+    for (size_t i = 0; i < got.size(); ++i) {
+        if (!std::isfinite(got[i])) throw std::runtime_error(std::string(name) + ": unwritten or non-finite output");
+        const double d = (double) got[i] - ref[i];
+        err2 += d * d; ref2 += (double) ref[i] * ref[i]; max_abs = std::max(max_abs, std::fabs(d));
+    }
+    for (int r = 0; r < rows; ++r)
+        if (src[(size_t) r] == rows - 1)   // the zero row
+            for (int64_t o = 0; o < out_rows; ++o)
+                zero_max = std::max(zero_max, (double) std::fabs(got[(size_t) dst[(size_t) r] * (size_t) out_rows + (size_t) o]));
+    const double rms = std::sqrt(ref2 / (double) ref.size()), rel = std::sqrt(err2 / (double) ref.size()) / rms;
+    std::printf("%-22s rows %2d experts %d  ref_rms %.4g  rel_l2 %.5f  max/rms %.4f  zero row %.3g\n", name, rows, n, rms,
+                rel, max_abs / rms, zero_max);
+    if (rel > 0.04 || max_abs / rms > 0.35 || zero_max > std::max(1e-5, 1e-4 * rms))
+        throw std::runtime_error(std::string(name) + ": outside the screen");
+}
+}  // namespace
+
+int main() {
+    try {
+        cudaDeviceProp prop{};
+        if(cudaGetDeviceProperties(&prop,0)!=cudaSuccess || prop.major!=6 || prop.minor!=1){std::puts("SKIP: real sm_61 required");return 77;}
+        if (!mmq::built()) { std::printf("no MMQ in this build\n"); return 1; }
+        // Reference IQ quantizers/dequantizers require their lookup tables.
+        // This is test setup; leave production quantization and error bounds unchanged.
+        for (ggml_type t : {GGML_TYPE_IQ3_S, GGML_TYPE_IQ4_NL, GGML_TYPE_Q2_0, GGML_TYPE_Q8_0})
+            ggml_quantize_init(t);
+        cudaStream_t s = nullptr;
+        ck(cudaStreamCreateWithFlags(&s, cudaStreamNonBlocking), "stream");
+        {
+            mmq::Context ctx;
+            const std::vector<std::vector<int>> batches{{1,3,3},{4,1,2},{17},{63},{96},{129}};
+            int trial = 0;
+            for (const auto& counts : batches) {
+                const std::string tag = "-" + std::to_string(trial);
+                product(ctx,s,("IQ3_S"+tag).c_str(),GGML_TYPE_IQ3_S,128,256,counts,trial);
+                product(ctx,s,("IQ4_NL"+tag).c_str(),GGML_TYPE_IQ4_NL,130,256,counts,trial+3);
+                product(ctx,s,("Q2_0"+tag).c_str(),GGML_TYPE_Q2_0,128,256,counts,trial+7);
+                product(ctx,s,("Q8_0"+tag).c_str(),GGML_TYPE_Q8_0,130,256,counts,trial+11);
+                ++trial;
+            }
+        }
+        ck(cudaStreamDestroy(s), "destroy");
+        ggml_quantize_free();
+        std::printf("Pascallama sm_61 MMQ numerical screen passed\n");
+        return 0;
+    } catch (const std::exception& e) {
+        std::fprintf(stderr, "Pascallama sm_61 MMQ numerical screen failed: %s\n", e.what());
+        return 1;
+    }
+}
diff --git a/tests/cuda/sm61_graph_parity.cu b/tests/cuda/sm61_graph_parity.cu
new file mode 100644
index 00000000..ab1c4842
--- /dev/null
+++ b/tests/cuda/sm61_graph_parity.cu
@@ -0,0 +1,25 @@
+// Local P40 qualification. No model, no ISA/SM guard bypass; mutable-buffer CUDA Graph replay vs direct kernels.
+#include <cuda_runtime.h>
+#include <cstdio>
+#include <vector>
+__global__ void transform(const float* x,float* y,int n){int i=(int)(blockIdx.x*blockDim.x+threadIdx.x);if(i<n)y[i]=x[i]*2.0f+1.0f;}
+int main(){
+  cudaDeviceProp prop{};if(cudaGetDeviceProperties(&prop,0)!=cudaSuccess||prop.major!=6||prop.minor!=1){std::puts("SKIP: this qualification targets real sm_61");return 77;}
+  const int n=4096;float *x=nullptr,*a=nullptr,*b=nullptr;cudaStream_t stream=nullptr;
+  if(cudaMalloc(&x,n*sizeof(float))||cudaMalloc(&a,n*sizeof(float))||cudaMalloc(&b,n*sizeof(float))||cudaStreamCreate(&stream))return 1;
+  cudaGraph_t graph=nullptr;cudaGraphExec_t exec=nullptr;
+  if(cudaStreamBeginCapture(stream,cudaStreamCaptureModeGlobal)!=cudaSuccess)return 1;
+  transform<<<16,256,0,stream>>>(x,b,n);
+  if(cudaStreamEndCapture(stream,&graph)!=cudaSuccess||cudaGraphInstantiate(&exec,graph,nullptr,nullptr,0)!=cudaSuccess)return 1;
+  std::vector<float> input(n),direct(n),captured(n);
+  for(int trial=0;trial<4;++trial){
+    for(int i=0;i<n;++i)input[i]=(float)(i+trial*17)/32.0f;
+    if(cudaMemcpyAsync(x,input.data(),n*sizeof(float),cudaMemcpyHostToDevice,stream)!=cudaSuccess)return 1;
+    transform<<<16,256,0,stream>>>(x,a,n);
+    if(cudaGraphLaunch(exec,stream)!=cudaSuccess||cudaStreamSynchronize(stream)!=cudaSuccess)return 1;
+    if(cudaMemcpy(direct.data(),a,n*sizeof(float),cudaMemcpyDeviceToHost)!=cudaSuccess||cudaMemcpy(captured.data(),b,n*sizeof(float),cudaMemcpyDeviceToHost)!=cudaSuccess)return 1;
+    for(int i=0;i<n;++i)if(direct[i]!=captured[i]||captured[i]!=input[i]*2.0f+1.0f)return 1;
+  }
+  cudaGraphExecDestroy(exec);cudaGraphDestroy(graph);cudaStreamDestroy(stream);cudaFree(x);cudaFree(a);cudaFree(b);
+  std::printf("PASS: %s sm_61 CUDA Graph capture/replay, changed inputs, bitwise direct parity\n",prop.name);return 0;
+}
diff --git a/tests/platform/cpu_format_parity.cpp b/tests/platform/cpu_format_parity.cpp
new file mode 100644
index 00000000..3d43a868
--- /dev/null
+++ b/tests/platform/cpu_format_parity.cpp
@@ -0,0 +1,181 @@
+// CPU arithmetic parity on valid GGML rows. No model, GPU, pinning, or unquantized-weight reference.
+#include "ggml.h"
+#include "ggml-cpu.h"
+#include "ggml-quants.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+namespace {
+constexpr int kCases = 16;
+constexpr double kAbsTolerance = 1e-4, kRelTolerance = 1e-4;
+
+uint64_t random_bits(uint64_t& state) {
+    uint64_t value = (state += UINT64_C(0x9e3779b97f4a7c15));
+    value = (value ^ (value >> 30)) * UINT64_C(0xbf58476d1ce4e5b9);
+    value = (value ^ (value >> 27)) * UINT64_C(0x94d049bb133111eb);
+    return value ^ (value >> 31);
+}
+
+float uniform(uint64_t& state) {
+    return static_cast<float>(random_bits(state) >> 40) * (2.0f / 16777216.0f) - 1.0f;
+}
+
+void make_inputs(int which, int n, std::vector<float>& weights, std::vector<float>& activations) {
+    uint64_t state = UINT64_C(0x20261020c001d00d) + static_cast<uint64_t>(which) * 12347 + n;
+    weights.resize(n);
+    activations.resize(n);
+    for (int i = 0; i < n; ++i) {
+        const float u = uniform(state), v = uniform(state);
+        float w = 0.05f * u, y = v;
+        switch (which) {
+            case 0: w = 0; break;
+            case 1: y = 0; break;
+            case 2: w = 0.125f; y = 0.25f; break;
+            case 3: w = (i & 1) ? -0.125f : 0.125f; y = (i & 1) ? -0.25f : 0.25f; break;
+            case 4: w = i == n / 3 ? -0.75f : 0; break;
+            case 5: y = i == n - 1 ? 0.75f : 0; break;
+            case 6: y = 0.5f * u; break;
+            case 7: y = -0.5f * u; break;
+            case 8: w = static_cast<float>(i % 15 - 7) * 0.003f; y = static_cast<float>(i % 11 - 5) * 0.1f; break;
+            case 9: y = (i & 1) ? -1.0f : 1.0f; break;
+            case 10: w = 0.03f * u; y = 0.75f * v; break;
+            case 11: w = 0.25f * u; y = 2.0f * v; break;
+            case 12: w = 0.001f * u; y = 0.5f * v; break;
+            case 13: w *= (i % 7 == 0) ? 8.0f : 0.015625f; break;
+            case 14: w = 0.015f * (1.0f + u); y = 0.5f * (1.0f + v); break;
+            case 15: w = 0.125f * u; y = (i % 3 == 0) ? -2.0f * v : 0.125f * v; break;
+        }
+        weights[i] = w;
+        activations[i] = y;
+    }
+}
+
+// Allocation is aligned for float/half access, including types whose CPU trait is an identity conversion.
+struct Row {
+    explicit Row(size_t size) : bytes(size), storage((size + sizeof(uint64_t) - 1) / sizeof(uint64_t)) {}
+    void* data() { return storage.data(); }
+    const void* data() const { return storage.data(); }
+    size_t bytes;
+    std::vector<uint64_t> storage;
+};
+
+bool dequantize(ggml_type type, const Row& source, std::vector<float>& output) {
+    if (type == GGML_TYPE_Q8_K) {
+        dequantize_row_q8_K(static_cast<const block_q8_K*>(source.data()), output.data(),
+                            static_cast<int64_t>(output.size()));
+        return true;
+    }
+    if (type == GGML_TYPE_F32) {
+        if (source.bytes != output.size() * sizeof(float)) return false;
+        std::memcpy(output.data(), source.data(), source.bytes);
+        return true;
+    }
+    const auto* traits = ggml_get_type_traits(type);
+    if (traits == nullptr || traits->to_float == nullptr) return false;
+    traits->to_float(source.data(), output.data(), static_cast<int64_t>(output.size()));
+    return true;
+}
+
+int check_type(ggml_type type) {
+    const char* name = ggml_type_name(type);
+    const auto* traits = ggml_get_type_traits_cpu(type);
+    if (traits == nullptr || traits->vec_dot == nullptr) {
+        std::fprintf(stderr, "FAIL %s: CPU vec_dot is unavailable\n", name);
+        return 1;
+    }
+    const ggml_type activation_type = traits->vec_dot_type;
+    const auto* activation_traits = ggml_get_type_traits_cpu(activation_type);
+    if (activation_traits == nullptr || activation_traits->from_float == nullptr) {
+        std::fprintf(stderr, "FAIL %s: production activation converter is unavailable\n", name);
+        return 1;
+    }
+
+    std::printf("CPU parity: %s x %s: initialize quantizer\n", name, ggml_type_name(activation_type));
+    const auto started = std::chrono::steady_clock::now();
+    ggml_quantize_init(type);
+    int failures = 0, checks = 0;
+    double max_abs = 0, max_bound_fraction = 0, max_float_abs = 0;
+    for (int n : {256, 2560}) {
+        if (n % ggml_blck_size(type) != 0 || n % ggml_blck_size(activation_type) != 0) {
+            std::fprintf(stderr, "FAIL %s: n=%d violates a weight/activation block size\n", name, n);
+            ++failures;
+            continue;
+        }
+        std::vector<float> source, input, weight_ref(n), activation_ref(n), importance(n, 1.0f);
+        Row weight_row(ggml_row_size(type, n)), activation_row(ggml_row_size(activation_type, n));
+        for (int which = 0; which < kCases; ++which) {
+            make_inputs(which, n, source, input);
+            const size_t written = ggml_quantize_chunk(type, source.data(), weight_row.data(), 0, 1, n,
+                ggml_quantize_requires_imatrix(type) ? importance.data() : nullptr);
+            if (written != weight_row.bytes) {
+                std::fprintf(stderr, "FAIL %s n=%d case=%d: quantizer wrote %zu, expected %zu bytes\n",
+                             name, n, which, written, weight_row.bytes);
+                ++failures;
+                continue;
+            }
+            activation_traits->from_float(input.data(), activation_row.data(), n);
+
+            if (!dequantize(type, weight_row, weight_ref) ||
+                !dequantize(activation_type, activation_row, activation_ref)) {
+                std::fprintf(stderr, "FAIL %s n=%d case=%d: independent operand dequantizer unavailable\n",
+                             name, n, which);
+                ++failures;
+                continue;
+            }
+
+            // Quantization affects both operands. Compare arithmetic on their decoded values, never on source floats.
+            double reference = 0;
+            float float_reference = 0;
+            bool finite = true;
+            for (int i = 0; i < n; ++i) {
+                finite = finite && std::isfinite(weight_ref[i]) && std::isfinite(activation_ref[i]);
+                reference += static_cast<double>(weight_ref[i]) * static_cast<double>(activation_ref[i]);
+                float_reference += weight_ref[i] * activation_ref[i];
+            }
+            float got = 0;
+            traits->vec_dot(n, &got, 0, weight_row.data(), 0, activation_row.data(), 0, 1);
+            const double error = std::fabs(static_cast<double>(got) - reference);
+            const double bound = kAbsTolerance + kRelTolerance * std::fabs(reference);
+            const bool ok = finite && std::isfinite(reference) && std::isfinite(float_reference) &&
+                            std::isfinite(got) && error <= bound;
+            max_abs = std::fmax(max_abs, error);
+            max_bound_fraction = std::fmax(max_bound_fraction, error / bound);
+            max_float_abs = std::fmax(max_float_abs, std::fabs(static_cast<double>(float_reference) - reference));
+            ++checks;
+            if (!ok) {
+                std::fprintf(stderr,
+                    "FAIL %s n=%d case=%d: got=%.9g decoded-double=%.17g decoded-float=%.9g error=%.6g bound=%.6g finite=%d\n",
+                    name, n, which, got, reference, float_reference, error, bound, static_cast<int>(finite));
+                ++failures;
+            }
+        }
+    }
+    ggml_quantize_free(); // Keep only one IQ codebook allocation alive at a time.
+    const double elapsed = std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count();
+    std::printf("%s: %d checks, max_abs=%.6g, max_bound_fraction=%.6g, float_accum_abs=%.6g, %.3fs: %s\n",
+                name, checks, max_abs, max_bound_fraction, max_float_abs, elapsed, failures ? "FAIL" : "PASS");
+    return failures;
+}
+} // namespace
+
+int main() {
+    setvbuf(stdout, nullptr, _IONBF, 0);
+    ggml_cpu_init();
+    static_assert(static_cast<int>(GGML_TYPE_Q2_0) == 42, "DavidAU Q2_0 must retain GGUF type ID 42");
+    const ggml_type types[] = {
+        GGML_TYPE_Q2_0, GGML_TYPE_IQ2_S, GGML_TYPE_IQ3_XXS, GGML_TYPE_IQ3_S,
+        GGML_TYPE_IQ4_XS, GGML_TYPE_IQ4_NL, GGML_TYPE_Q4_K, GGML_TYPE_Q5_K,
+        GGML_TYPE_Q6_K, GGML_TYPE_Q8_0, GGML_TYPE_F16, GGML_TYPE_BF16, GGML_TYPE_F32,
+    };
+    int failures = 0;
+    for (ggml_type type : types) failures += check_type(type);
+    std::printf("CPU format parity: 13 types x 2 lengths x %d cases; arithmetic tolerance %.1e + %.1e*abs(decoded-double); failures=%d\n",
+                kCases, kAbsTolerance, kRelTolerance, failures);
+    return failures ? 1 : 0;
+}
diff --git a/tests/platform/no_cpu_pin_test.cpp b/tests/platform/no_cpu_pin_test.cpp
new file mode 100644
index 00000000..631691ca
--- /dev/null
+++ b/tests/platform/no_cpu_pin_test.cpp
@@ -0,0 +1,245 @@
+// Exercise production CPU placement with counted imports. No test path calls a Windows placement setter.
+#include "strata/kernels/cpu/pool.hpp"
+#include "strata/platform/cpu_pinning.hpp"
+#include "../../src/kernels/cpu/pool_affinity_win.hpp"
+
+#include <tlhelp32.h>
+#include <algorithm>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <thread>
+#include <vector>
+
+namespace cpu = strata::kernels::cpu;
+
+namespace {
+std::atomic<unsigned> group_calls{0}, cpu_set_calls{0};
+int failures = 0;
+
+bool check(bool ok, const char* what) {
+    if (!ok) {
+        std::fprintf(stderr, "no_cpu_pin_test: %s (error %lu)\n", what, (unsigned long) GetLastError());
+        ++failures;
+    }
+    return ok;
+}
+
+BOOL WINAPI count_group(HANDLE, const GROUP_AFFINITY*, PGROUP_AFFINITY) {
+    ++group_calls;
+    SetLastError(ERROR_ACCESS_DENIED);
+    return FALSE;
+}
+
+BOOL WINAPI count_cpu_sets(HANDLE, const ULONG*, ULONG) {
+    ++cpu_set_calls;
+    SetLastError(ERROR_ACCESS_DENIED);
+    return FALSE;
+}
+
+// Hook only this test executable's two import slots. SDK import libraries can group
+// several imports in one object, so defining __imp_* symbols would cause duplicate symbols.
+struct ImportHooks {
+    struct Entry { void** slot; void* original; };
+    std::vector<Entry> entries;
+
+    bool install() {
+        auto* image = reinterpret_cast<unsigned char*>(GetModuleHandleW(nullptr));
+        const auto* dos = reinterpret_cast<const IMAGE_DOS_HEADER*>(image);
+        if (dos->e_magic != IMAGE_DOS_SIGNATURE) return false;
+        const auto* nt = reinterpret_cast<const IMAGE_NT_HEADERS64*>(image + dos->e_lfanew);
+        if (nt->Signature != IMAGE_NT_SIGNATURE) return false;
+        const DWORD rva = nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_IMPORT].VirtualAddress;
+        if (!rva) return false;
+        const auto* descriptor = reinterpret_cast<const IMAGE_IMPORT_DESCRIPTOR*>(image + rva);
+        for (; descriptor->Name; ++descriptor) {
+            if (!descriptor->OriginalFirstThunk) continue;
+            const auto* names = reinterpret_cast<const IMAGE_THUNK_DATA64*>(image + descriptor->OriginalFirstThunk);
+            auto* imports = reinterpret_cast<IMAGE_THUNK_DATA64*>(image + descriptor->FirstThunk);
+            for (; names->u1.AddressOfData; ++names, ++imports) {
+                if (IMAGE_SNAP_BY_ORDINAL64(names->u1.Ordinal)) continue;
+                const auto* named = reinterpret_cast<const IMAGE_IMPORT_BY_NAME*>(image + names->u1.AddressOfData);
+                void* replacement = nullptr;
+                if (std::strcmp(reinterpret_cast<const char*>(named->Name), "SetThreadGroupAffinity") == 0)
+                    replacement = reinterpret_cast<void*>(count_group);
+                else if (std::strcmp(reinterpret_cast<const char*>(named->Name), "SetThreadSelectedCpuSets") == 0)
+                    replacement = reinterpret_cast<void*>(count_cpu_sets);
+                if (!replacement) continue;
+                auto** slot = reinterpret_cast<void**>(&imports->u1.Function);
+                DWORD protection = 0;
+                if (!VirtualProtect(slot, sizeof(*slot), PAGE_READWRITE, &protection)) return false;
+                void* original = InterlockedExchangePointer(slot, replacement);
+                DWORD ignored = 0;
+                if (!VirtualProtect(slot, sizeof(*slot), protection, &ignored)) return false;
+                entries.push_back({slot, original});
+            }
+        }
+        return entries.size() == 2;
+    }
+
+    ~ImportHooks() {
+        for (const auto& entry : entries) {
+            DWORD protection = 0;
+            if (VirtualProtect(entry.slot, sizeof(*entry.slot), PAGE_READWRITE, &protection)) {
+                InterlockedExchangePointer(entry.slot, entry.original);
+                DWORD ignored = 0;
+                VirtualProtect(entry.slot, sizeof(*entry.slot), protection, &ignored);
+            }
+        }
+    }
+};
+
+struct Placement {
+    GROUP_AFFINITY thread{};
+    DWORD_PTR process_mask = 0, system_mask = 0;
+    std::vector<ULONG> selected, defaults;
+    std::vector<USHORT> groups;
+};
+
+bool read_placement(HANDLE thread, Placement& out) {
+    if (!GetThreadGroupAffinity(thread, &out.thread) ||
+        !GetProcessAffinityMask(GetCurrentProcess(), &out.process_mask, &out.system_mask)) return false;
+
+    ULONG count = 0;
+    if (!GetThreadSelectedCpuSets(thread, nullptr, 0, &count) &&
+        GetLastError() != ERROR_INSUFFICIENT_BUFFER) return false;
+    out.selected.resize(count);
+    if (count && !GetThreadSelectedCpuSets(thread, out.selected.data(), count, &count)) return false;
+    out.selected.resize(count);
+
+    count = 0;
+    if (!GetProcessDefaultCpuSets(GetCurrentProcess(), nullptr, 0, &count) &&
+        GetLastError() != ERROR_INSUFFICIENT_BUFFER) return false;
+    out.defaults.resize(count);
+    if (count && !GetProcessDefaultCpuSets(GetCurrentProcess(), out.defaults.data(), count, &count)) return false;
+    out.defaults.resize(count);
+
+    USHORT group_count = GetActiveProcessorGroupCount();
+    out.groups.resize(group_count);
+    if (!GetProcessGroupAffinity(GetCurrentProcess(), &group_count, out.groups.data())) return false;
+    out.groups.resize(group_count);
+    std::sort(out.selected.begin(), out.selected.end());
+    std::sort(out.defaults.begin(), out.defaults.end());
+    std::sort(out.groups.begin(), out.groups.end());
+    return true;
+}
+
+bool same(const Placement& a, const Placement& b) {
+    return a.thread.Group == b.thread.Group && a.thread.Mask == b.thread.Mask &&
+           a.process_mask == b.process_mask && a.system_mask == b.system_mask &&
+           a.selected == b.selected && a.defaults == b.defaults && a.groups == b.groups;
+}
+
+bool unchanged(HANDLE thread, const Placement& before, const char* what) {
+    Placement after;
+    return check(read_placement(thread, after) && same(before, after), what);
+}
+
+bool process_threads(std::vector<DWORD>& ids) {
+    const HANDLE snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+    if (snapshot == INVALID_HANDLE_VALUE) return false;
+    THREADENTRY32 entry{};
+    entry.dwSize = sizeof(entry);
+    bool ok = Thread32First(snapshot, &entry) != 0;
+    if (ok) {
+        do {
+            if (entry.th32OwnerProcessID == GetCurrentProcessId()) ids.push_back(entry.th32ThreadID);
+            entry.dwSize = sizeof(entry);
+        } while (Thread32Next(snapshot, &entry));
+        ok = GetLastError() == ERROR_NO_MORE_FILES;
+    }
+    CloseHandle(snapshot);
+    std::sort(ids.begin(), ids.end());
+    return ok;
+}
+
+void exercise_caller(int core, bool disabled) {
+    Placement before;
+    if (!check(read_placement(GetCurrentThread(), before), "read inherited caller placement")) return;
+    const auto previous = cpu::pin_current_thread(core);
+    check(!previous.valid, "a disabled or rejected host pin must not return a restorable assignment");
+    unchanged(GetCurrentThread(), before, "host pin preserves inherited placement");
+    cpu::restore_thread_affinity(previous);
+    unchanged(GetCurrentThread(), before, "invalid restore preserves inherited placement");
+
+    // An otherwise valid snapshot must also do nothing when pinning is disabled.
+    cpu::ThreadAffinity synthetic;
+    synthetic.valid = true;
+    synthetic.cpu_sets.assign(before.selected.begin(), before.selected.end());
+    cpu::restore_thread_affinity(synthetic);
+    unchanged(GetCurrentThread(), before, "valid restore preserves inherited placement");
+
+    check(!cpu::detail::set_thread_group_affinity(core, 7), "disabled or rejected worker pin reports false");
+    unchanged(GetCurrentThread(), before, "worker helper preserves inherited placement");
+    if (disabled) check(group_calls.load() == 0 && cpu_set_calls.load() == 0,
+                        "disabled caller paths must make zero placement calls");
+}
+
+void exercise_pool(bool disabled) {
+    Placement caller;
+    std::vector<DWORD> before, during;
+    if (!check(read_placement(GetCurrentThread(), caller), "read caller before pool") ||
+        !check(process_threads(before), "enumerate threads before pool")) return;
+
+    {
+        cpu::ExpertPool pool(2, true, false);
+        check(pool.workers() == 2, "production pool creates requested workers");
+        if (check(process_threads(during), "enumerate production pool workers")) {
+            unsigned observed = 0;
+            for (DWORD id : during) {
+                if (std::binary_search(before.begin(), before.end(), id)) continue;
+                const HANDLE thread = OpenThread(THREAD_QUERY_INFORMATION, FALSE, id);
+                if (!check(thread != nullptr, "open own pool worker for readback")) continue;
+                Placement inherited;
+                if (check(read_placement(thread, inherited), "read own pool worker placement")) {
+                    check(inherited.process_mask == caller.process_mask &&
+                          inherited.system_mask == caller.system_mask && inherited.defaults == caller.defaults &&
+                          inherited.groups == caller.groups, "pool worker keeps inherited process scope");
+                    check(inherited.thread.Group == caller.thread.Group && inherited.thread.Mask == caller.thread.Mask &&
+                          inherited.selected == caller.selected, "pool worker keeps inherited thread mask and CPU Sets");
+                    unchanged(thread, inherited, "pool worker placement stays unchanged during readback");
+                    ++observed;
+                }
+                CloseHandle(thread);
+            }
+            check(observed == 2, "read back both production pool workers");
+        }
+    } // Join workers before checking counts, so every startup pin has finished.
+    unchanged(GetCurrentThread(), caller, "pool lifetime preserves caller placement");
+    if (disabled) check(group_calls.load() == 0 && cpu_set_calls.load() == 0,
+                        "production pool must make zero placement calls");
+}
+} // namespace
+
+int main(int argc, char** argv) {
+    const bool disabled = argc == 1;
+    if (!disabled && (argc != 2 || std::strcmp(argv[1], "--positive-control") != 0)) {
+        std::fprintf(stderr, "usage: no_cpu_pin_test [--positive-control]\n");
+        return 2;
+    }
+    ImportHooks hooks;
+    if (!check(hooks.install(), "replace both placement imports in this test process")) return 1;
+    if (!check(_putenv_s("STRATA_NO_CPU_PIN", disabled ? "1" : "0") == 0, "set process-local opt-in") ||
+        !check(strata::no_cpu_pin() == disabled, "read exact process-local opt-in")) return 1;
+
+    const auto cores = cpu::physical_cores(false);
+    if (!check(!cores.empty(), "find valid target CPU")) return 1;
+    ULONG id = 0;
+    if (!check(cpu::detail::cpu_set_for_core(cores.front(), id), "resolve valid target CPU Set")) return 1;
+
+    Placement original;
+    if (!check(read_placement(GetCurrentThread(), original), "read original placement")) return 1;
+    exercise_caller(cores.front(), disabled);
+    std::thread inherited([&] { exercise_caller(cores.front(), disabled); });
+    inherited.join();
+    exercise_pool(disabled);
+    unchanged(GetCurrentThread(), original, "final process/thread placement matches original");
+    if (disabled) check(group_calls.load() == 0 && cpu_set_calls.load() == 0, "zero placement calls overall");
+    else check(group_calls.load() >= 4 && cpu_set_calls.load() >= 4,
+               "positive control reaches both real production import paths");
+
+    std::printf("no_cpu_pin_test: %s: group calls=%u, CPU Set calls=%u, failures=%d; no OS placement setters executed\n",
+                disabled ? "disabled" : "positive control", group_calls.load(), cpu_set_calls.load(), failures);
+    return failures ? 1 : 0;
+}
diff --git a/tests/platform/ple_reader_lifecycle.cpp b/tests/platform/ple_reader_lifecycle.cpp
new file mode 100644
index 00000000..1f78f556
--- /dev/null
+++ b/tests/platform/ple_reader_lifecycle.cpp
@@ -0,0 +1,127 @@
+// CPU-only lifecycle regressions using real DirectFile I/O; allocation failure is injected at link time.
+#include "strata/ngram/ple_reader.hpp"
+
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+#if defined(_WIN32)
+#include <io.h>
+#include <fcntl.h>
+#include <sys/stat.h>
+#else
+#include <unistd.h>
+#endif
+
+#ifdef STRATA_TEST_ALLOC_FAILURE
+static bool fail_alloc = false;
+extern "C" int __real_posix_memalign(void**, size_t, size_t);
+extern "C" int __wrap_posix_memalign(void** out, size_t alignment, size_t bytes) {
+    if (fail_alloc) { fail_alloc = false; return ENOMEM; }
+    return __real_posix_memalign(out, alignment, bytes);
+}
+#endif
+
+namespace {
+using strata::ngram::PleReader;
+constexpr uint32_t kRows = 128, kRowBytes = 90;
+constexpr size_t kFileBytes = 16384;
+void check(bool ok, const std::string& why) { if (!ok) throw std::runtime_error(why); }
+uint8_t pattern(size_t i) { return (uint8_t) ((i * 17 + i / 257) & 255); }
+
+struct Table {
+    std::filesystem::path path;
+    Table() {
+        std::string name = (std::filesystem::temp_directory_path() / "strata-ple-lifecycle-XXXXXX").string();
+#if defined(_WIN32)
+        check(_mktemp_s(name.data(), name.size() + 1) == 0, "temporary name failed");
+        const int fd = _open(name.c_str(), _O_CREAT | _O_EXCL | _O_RDWR | _O_BINARY, _S_IREAD | _S_IWRITE);
+        check(fd >= 0, "temporary file open failed");
+        _close(fd);
+#else
+        const int fd = mkstemp(name.data());
+        check(fd >= 0, "mkstemp failed");
+        ::close(fd);
+#endif
+        path = name;
+        std::vector<uint8_t> bytes(kFileBytes);
+        for (size_t i = 0; i < bytes.size(); ++i) bytes[i] = pattern(i);
+        std::ofstream f(path, std::ios::binary | std::ios::trunc);
+        f.write(reinterpret_cast<const char*>(bytes.data()), (std::streamsize) bytes.size());
+        check((bool) f, "cannot write fixture");
+    }
+    ~Table() { std::error_code ignored; std::filesystem::remove(path, ignored); }
+};
+
+void open(PleReader& r, const Table& table, bool threaded) {
+    std::string err;
+    const bool ok = r.open(table.path.string(), 0, kRows, 4, 0, err, threaded, kRowBytes);
+    check(ok, "open failed: " + err);
+}
+
+void read(PleReader& r) {
+    const uint32_t rows[] = {0, 45, 91, 127}; // different pages, including a row that crosses a page boundary
+    std::vector<uint8_t> out(4 * kRowBytes, 0);
+    const auto ticket = r.issue(rows, 4, out.data());
+    std::string err;
+    const bool ok = r.collect(ticket, err);
+    check(ok, "collect failed: " + err);
+    for (size_t i = 0; i < 4; ++i)
+        for (size_t b = 0; b < kRowBytes; ++b)
+            check(out[i * kRowBytes + b] == pattern((size_t) rows[i] * kRowBytes + b), "row bytes changed");
+}
+
+void refused(PleReader& r, const Table& table, bool threaded, bool allocation) {
+    std::string err;
+#ifdef STRATA_TEST_ALLOC_FAILURE
+    if (allocation) fail_alloc = true;
+#endif
+    const bool ok = r.open(table.path.string(), allocation ? 0 : kFileBytes, kRows, 4, 0, err,
+                           threaded, kRowBytes);
+    check(!ok, "invalid initialization was accepted");
+    check(err.find(allocation ? "cannot allocate read buffers" : "table extends past the end") != std::string::npos,
+          "unexpected initialization error: " + err);
+#ifdef STRATA_TEST_ALLOC_FAILURE
+    check(!fail_alloc, "allocation failure was not exercised");
+#endif
+    check(!r.is_open(), "failed reader kept its file open");
+    r.close();
+    r.close();
+}
+} // namespace
+
+int main(int argc, char** argv) {
+    try {
+        check(argc == 3, "usage: ple_reader_lifecycle_test reads|reopen|alloc caller|threaded");
+        const std::string mode = argv[1];
+        const bool threaded = std::string(argv[2]) == "threaded";
+        check(mode == "reads" || mode == "reopen" || mode == "alloc", "unknown case");
+        Table table;
+        PleReader r;
+        if (mode != "reads") refused(r, table, threaded, mode == "alloc");
+        open(r, table, threaded);
+        read(r);
+        // open() must also clean up a previously initialized reader before handling the new failure.
+        if (mode != "reads") refused(r, table, threaded, mode == "alloc");
+        else {
+            const uint32_t rows[] = {0, 45, 91, 127};
+            std::vector<uint8_t> out(4 * kRowBytes, 0);
+            (void) r.issue(rows, 4, out.data());
+            r.close(); // outstanding writes must finish before out is released
+        }
+        r.close();
+        open(r, table, threaded);
+        read(r);
+        r.close();
+        r.close();
+        std::printf("%s %s: passed\n", argv[1], argv[2]);
+        return 0;
+    } catch (const std::exception& e) {
+        std::fprintf(stderr, "%s\n", e.what());
+        return 1;
+    }
+}
diff --git a/tests/platform/windows_numa_arena_test.cpp b/tests/platform/windows_numa_arena_test.cpp
new file mode 100644
index 00000000..8f24a8d8
--- /dev/null
+++ b/tests/platform/windows_numa_arena_test.cpp
@@ -0,0 +1,49 @@
+#include "strata/platform/win_numa_arena.hpp"
+#include <cstdio>
+#include <cstring>
+using namespace strata::platform::win_numa;
+#define CHECK(x) do { ++cases; if (!(x)) { std::fprintf(stderr,"FAIL line %d: %s\n",__LINE__,#x); return 1; } } while(0)
+int main() {
+    int cases = 0;
+    const uint64_t gib = 1ull << 30;
+    const std::vector<Node> two{{0,128*gib,true},{3,128*gib,true}};
+    CHECK(!choose(nullptr,two,0,gib).requested);
+    CHECK(!choose("off",two,0,gib).requested);
+    CHECK(choose("gpu",two,3,gib).node==3);
+    CHECK(choose("auto",two,0,gib).node==0);
+    CHECK(choose("0",two,-1,gib).node==0);
+    CHECK(choose("3",two,-1,gib).node==3);
+    CHECK(choose("gpu",two,-1,gib).node<0);
+    CHECK(choose("1",two,0,gib).node<0);
+    CHECK(choose("3",{{0,128*gib,true},{3,128*gib,false}},0,gib).node<0);
+    CHECK(choose("0",{{0,128*gib,true}},0,gib).node<0);
+    CHECK(choose("0",two,0,125*gib).node<0);
+    CHECK(choose("0",two,0,124*gib).node==0);
+    CHECK(choose("0",two,0,~uint64_t(0)).node<0);
+    CHECK(choose("65536",two,0,gib).node<0);
+    CHECK(choose("99999999999999999999",two,0,gib).node<0);
+    CHECK(choose("-1",two,0,gib).node<0);
+    CHECK(choose(" 0",two,0,gib).node<0);
+    CHECK(choose("0x0",two,0,gib).node<0);
+    DWORD_PTR before=0,system=0,after=0,system_after=0;
+    CHECK(GetProcessAffinityMask(GetCurrentProcess(),&before,&system));
+    CHECK(!probe("off",-1,gib).requested);
+    // Small real Win32 API positive control. This does not claim a two-node host or enable production policy.
+    GROUP_AFFINITY mask{};
+    CHECK(GetNumaNodeProcessorMaskEx(0,&mask) && mask.Mask);
+    const SIZE_T bytes=2*1024*1024;
+    std::string note;
+    void* memory=allocate(bytes,MEM_COMMIT|MEM_RESERVE,Decision{0,true,"test node0 preferred"},note);
+    CHECK(memory!=nullptr);
+    std::memset(memory,0x5a,bytes);
+    const auto* data=static_cast<const unsigned char*>(memory);
+    bool intact=true; for(SIZE_T i=0;i<bytes;++i) if(data[i]!=0x5a){intact=false;break;}
+    CHECK(intact);
+    const std::string sample=placement(memory,bytes,0);
+    CHECK(sample.find("NUMA page sample local/remote/not-resident=")!=std::string::npos);
+    CHECK(VirtualFree(memory,0,MEM_RELEASE));
+    CHECK(GetProcessAffinityMask(GetCurrentProcess(),&after,&system_after));
+    CHECK(before==after && system==system_after);
+    std::printf("Windows NUMA arena: %d cases PASS; no CPU affinity changes; %s\n",cases,sample.c_str());
+    return 0;
+}
