# The complete upstream pascallama patch is applied only to a private build-tree copy of pinned ggml.
function(strata_pascallama_overlay original destination patch git)
  if(NOT EXISTS "${patch}" OR NOT EXISTS "${git}")
    message(FATAL_ERROR "Verified pascallama patch/private Git are required")
  endif()
  # A cache hit requires exact original inputs, this recipe and every patched output byte.
  # It skips only rewriting identical headers, never patch checks for new inputs.
  file(GLOB_RECURSE _pascal_inputs RELATIVE "${original}" "${original}/ggml/*.h" "${original}/ggml/*.cuh" "${original}/ggml/*.cu")
  list(SORT _pascal_inputs)
  file(SHA256 "${patch}" _pascal_patch_sha)
  file(SHA256 "${CMAKE_CURRENT_FUNCTION_LIST_FILE}" _pascal_recipe_sha)
  set(_pascal_material "${_pascal_patch_sha}|${_pascal_recipe_sha}\n")
  foreach(_entry IN LISTS _pascal_inputs)
    file(SHA256 "${original}/${_entry}" _entry_sha)
    string(APPEND _pascal_material "${_entry}|${_entry_sha}\n")
  endforeach()
  string(SHA256 _pascal_key "${_pascal_material}")
  set(_pascal_stamp "${destination}/.strata-pascallama-cache.txt")
  if(EXISTS "${_pascal_stamp}")
    file(STRINGS "${_pascal_stamp}" _pascal_rows)
    list(POP_FRONT _pascal_rows _pascal_old_key)
    set(_pascal_valid TRUE)
    if(NOT _pascal_old_key STREQUAL _pascal_key)
      set(_pascal_valid FALSE)
    endif()
    file(GLOB_RECURSE _pascal_present RELATIVE "${destination}" "${destination}/ggml/*.h" "${destination}/ggml/*.cuh" "${destination}/ggml/*.cu")
    list(LENGTH _pascal_present _pascal_present_n)
    list(LENGTH _pascal_rows _pascal_rows_n)
    if(NOT _pascal_present_n EQUAL _pascal_rows_n)
      set(_pascal_valid FALSE)
    endif()
    set(_pascal_seen)
    foreach(_row IN LISTS _pascal_rows)
      if(NOT _row MATCHES "^([^|]+)[|]([0-9a-fA-F]+)$")
        set(_pascal_valid FALSE)
        break()
      endif()
      set(_entry "${CMAKE_MATCH_1}")
      set(_expected "${CMAKE_MATCH_2}")
      if(_entry IN_LIST _pascal_seen)
        set(_pascal_valid FALSE)
        break()
      endif()
      list(APPEND _pascal_seen "${_entry}")
      if(_entry MATCHES "(^|/)\\.\\.(/|$)" OR IS_ABSOLUTE "${_entry}" OR NOT EXISTS "${destination}/${_entry}" OR IS_SYMLINK "${destination}/${_entry}")
        set(_pascal_valid FALSE)
        break()
      endif()
      file(SHA256 "${destination}/${_entry}" _entry_sha)
      if(NOT _entry_sha STREQUAL _expected)
        set(_pascal_valid FALSE)
        break()
      endif()
    endforeach()
    list(SORT _pascal_seen)
    list(SORT _pascal_present)
    if(NOT "${_pascal_seen}" STREQUAL "${_pascal_present}")
      set(_pascal_valid FALSE)
    endif()
    if(_pascal_valid)
      message(STATUS "Pascallama private overlay: exact input/output cache hit; headers left untouched")
      return()
    endif()
  endif()
  file(MAKE_DIRECTORY "${destination}")
  file(COPY "${original}/ggml" DESTINATION "${destination}" FILES_MATCHING PATTERN "*.h" PATTERN "*.cuh" PATTERN "*.cu")
  foreach(_name mmq-config-pascal-dp4a.cuh mmq-vec-dot.cuh)
    set(_file "${destination}/ggml/src/ggml-cuda/${_name}")
    file(READ "${original}/ggml/src/ggml-cuda/${_name}" _text)
    string(REPLACE "\r\n" "\n" _text "${_text}")
    file(CONFIGURE OUTPUT "${_file}" CONTENT "${_text}" @ONLY NEWLINE_STYLE UNIX)
  endforeach()
  execute_process(COMMAND "${git}" -c core.autocrlf=false -c core.safecrlf=false -C "${destination}" apply --check "${patch}" RESULT_VARIABLE _check OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
  if(NOT _check EQUAL 0)
    message(FATAL_ERROR "Pascallama patch does not match pinned ggml: ${_stdout}${_stderr}")
  endif()
  execute_process(COMMAND "${git}" -c core.autocrlf=false -c core.safecrlf=false -C "${destination}" apply "${patch}" RESULT_VARIABLE _apply OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
  if(NOT _apply EQUAL 0)
    message(FATAL_ERROR "Pascallama private overlay failed: ${_stdout}${_stderr}")
  endif()
  file(GLOB_RECURSE _pascal_outputs RELATIVE "${destination}" "${destination}/ggml/*.h" "${destination}/ggml/*.cuh" "${destination}/ggml/*.cu")
  list(SORT _pascal_outputs)
  set(_pascal_record "${_pascal_key}\n")
  foreach(_entry IN LISTS _pascal_outputs)
    file(SHA256 "${destination}/${_entry}" _entry_sha)
    string(APPEND _pascal_record "${_entry}|${_entry_sha}\n")
  endforeach()
  file(WRITE "${_pascal_stamp}" "${_pascal_record}")
  message(STATUS "Experimental P40 MMQ: complete pascallama J96 config and nine DP4A unroll hints; pinned dependency untouched")
endfunction()
