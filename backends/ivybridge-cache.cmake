# Explicit legacy-machine initial cache. Use with cmake -C; no OS/global environment changes.
if(CMAKE_HOST_WIN32)
  set(CMAKE_C_COMPILER clang-cl CACHE STRING "Legacy CPU compiler")
  set(CMAKE_CXX_COMPILER clang-cl CACHE STRING "Legacy CPU compiler")
  set(_cpu "/MD /O2 /DNDEBUG /arch:AVX /fp:precise /clang:-O3 /clang:-march=ivybridge /clang:-mtune=ivybridge /clang:-mno-avx2 /clang:-mno-fma /clang:-mno-f16c /clang:-ffp-contract=off /clang:-fno-fast-math")
  set(CMAKE_CUDA_FLAGS_RELEASE "-O3 -DNDEBUG -Xcompiler=/O2 -Xcompiler=/Ob3 -Xcompiler=/favor:INTEL64 -Xcompiler=/fp:precise -Xcompiler=/arch:AVX" CACHE STRING "Pascal CUDA and MSVC host flags")
else()
  set(_cpu "-O3 -DNDEBUG -march=ivybridge -mtune=ivybridge -mno-avx2 -mno-fma -mno-f16c -ffp-contract=off -fno-fast-math")
  set(CMAKE_CUDA_FLAGS_RELEASE "-O3 -DNDEBUG -Xcompiler=-O3 -Xcompiler=-march=ivybridge -Xcompiler=-mtune=ivybridge -Xcompiler=-mno-avx2 -Xcompiler=-mno-fma -Xcompiler=-mno-f16c -Xcompiler=-ffp-contract=off -Xcompiler=-fno-fast-math" CACHE STRING "Pascal CUDA and AVX host flags")
endif()
set(CMAKE_C_FLAGS_RELEASE "${_cpu}" CACHE STRING "Ivy Bridge strict O3")
set(CMAKE_CXX_FLAGS_RELEASE "${_cpu}" CACHE STRING "Ivy Bridge strict O3")
set(CMAKE_CUDA_ARCHITECTURES 61 CACHE STRING "Tesla P40")
set(CMAKE_BUILD_TYPE Release CACHE STRING "Release build")
set(CMAKE_INTERPROCEDURAL_OPTIMIZATION OFF CACHE BOOL "No unselected LTO")
set(CMAKE_EXPORT_COMPILE_COMMANDS ON CACHE BOOL "Record compiler input")
