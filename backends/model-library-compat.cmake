# Only pinned build copies; preserve the native Strata dependency and all ISA/feature/size guards.
if(NOT STRATA_LLAMA_PIN STREQUAL "b9acf138a1e28ce1fc23b5a4fc4b12444b50f7ea")
  message(FATAL_ERROR "Review the library compatibility port for this exact dependency before building")
endif()
if(NOT STRATA_PRIVATE_PYTHON)
  find_package(Python3 REQUIRED COMPONENTS Interpreter)
  set(STRATA_PRIVATE_PYTHON "${Python3_EXECUTABLE}")
endif()
set(_compat "${CMAKE_BINARY_DIR}/model-library-compat")
execute_process(COMMAND "${STRATA_PRIVATE_PYTHON}" "${CMAKE_CURRENT_LIST_DIR}/prepare-library-compat.py"
  --source "${STRATA_LLAMA_SOURCE}" --output "${_compat}" RESULT_VARIABLE _result OUTPUT_QUIET)
if(NOT _result EQUAL 0)
  message(FATAL_ERROR "Pinned model-library compatibility preparation failed")
endif()
function(_strata_library_copy TARGET RELATIVE)
  if(NOT TARGET ${TARGET})
    return()
  endif()
  get_target_property(_dir ${TARGET} SOURCE_DIR)
  get_target_property(_sources ${TARGET} SOURCES)
  file(REAL_PATH "${STRATA_LLAMA_SOURCE}/${RELATIVE}" _original)
  set(_mapped)
  set(_count 0)
  foreach(_source IN LISTS _sources)
    if(NOT _source MATCHES "^\\$<")
      file(REAL_PATH "${_source}" _absolute BASE_DIRECTORY "${_dir}")
    else()
      set(_absolute "")
    endif()
    if(_absolute STREQUAL _original)
      list(APPEND _mapped "${_compat}/${RELATIVE}")
      math(EXPR _count "${_count}+1")
    else()
      list(APPEND _mapped "${_source}")
    endif()
  endforeach()
  if(NOT _count EQUAL 1)
    message(FATAL_ERROR "Library compile source is not unique: ${RELATIVE}")
  endif()
  get_filename_component(_include "${_original}" DIRECTORY)
  if(NOT RELATIVE STREQUAL "common/jinja/value.cpp")
    target_include_directories(${TARGET} PRIVATE "${_include}")
  endif()
  set_property(TARGET ${TARGET} PROPERTY SOURCES "${_mapped}")
endfunction()
_strata_library_copy(llama "src/llama-grammar.cpp")
_strata_library_copy(llama-common "common/jinja/value.cpp")
_strata_library_copy(ggml-vulkan "ggml/src/ggml-vulkan/ggml-vulkan.cpp")

# PR30454: retain the pinned dependency; compile only its reviewed CPU planner copy.
_strata_library_copy(ggml-cpu "ggml/src/ggml-cpu/ggml-cpu.c")

# PR31336: the neighbouring generated common.h bounds the model-specific loader.
_strata_library_copy(llama-common "common/common.cpp")
