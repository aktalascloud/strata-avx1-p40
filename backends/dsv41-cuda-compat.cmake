# Pascal compile compatibility over pinned build copies. Never changes upstream or live files.
if(TARGET strata-dsv41 AND WIN32 AND CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
  # NVCC's MSVC final link does not add Clang's CPU-detection builtins automatically.
  execute_process(COMMAND "${CMAKE_CXX_COMPILER}" -print-resource-dir
    OUTPUT_VARIABLE _clang_resource RESULT_VARIABLE _clang_result OUTPUT_STRIP_TRAILING_WHITESPACE)
  file(TO_CMAKE_PATH "${_clang_resource}" _clang_resource)
  set(_cpu_runtime "${_clang_resource}/lib/windows/clang_rt.builtins-x86_64.lib")
  if(NOT _clang_result EQUAL 0 OR NOT EXISTS "${_cpu_runtime}")
    message(FATAL_ERROR "The configured Clang CPU-detection runtime is required; do not remove the CPU ISA guards")
  endif()
  target_link_libraries(strata-dsv41 PRIVATE "${_cpu_runtime}")
endif()
if(NOT TARGET strata-dsv41 OR NOT STRATA_ENABLE_CUDA OR NOT CMAKE_CUDA_ARCHITECTURES STREQUAL "61")
  return()
endif()

function(_dsv_replace_once OUT TEXT NEEDLE REPLACEMENT)
  string(FIND "${TEXT}" "${NEEDLE}" _first)
  if(_first LESS 0)
    message(FATAL_ERROR "DSV41 Pascal source anchor is missing")
  endif()
  string(LENGTH "${NEEDLE}" _length)
  math(EXPR _after "${_first}+${_length}")
  string(SUBSTRING "${TEXT}" ${_after} -1 _tail)
  string(FIND "${_tail}" "${NEEDLE}" _again)
  if(NOT _again LESS 0)
    message(FATAL_ERROR "DSV41 Pascal source anchor is not unique")
  endif()
  string(REPLACE "${NEEDLE}" "${REPLACEMENT}" _out "${TEXT}")
  set(${OUT} "${_out}" PARENT_SCOPE)
endfunction()

function(_dsv_compile_copy TARGET RELATIVE EXPECTED BODY)
  set(_original "${STRATA_CORE_SOURCE}/${RELATIVE}")
  file(SHA256 "${_original}" _actual)
  if(NOT _actual STREQUAL EXPECTED)
    message(FATAL_ERROR "DSV41 source changed: ${RELATIVE}; review before adapting its Pascal feature guards")
  endif()
  get_filename_component(_name "${RELATIVE}" NAME)
  set(_copy "${CMAKE_BINARY_DIR}/dsv41-pascal-compat/${_name}")
  file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/dsv41-pascal-compat")
  if(EXISTS "${_copy}")
    file(READ "${_copy}" _prior)
  else()
    set(_prior "")
  endif()
  if(NOT _prior STREQUAL BODY)
    file(WRITE "${_copy}" "${BODY}")
  endif()
  get_target_property(_sources ${TARGET} SOURCES)
  set(_mapped "")
  set(_count 0)
  foreach(_source IN LISTS _sources)
    if(_source STREQUAL RELATIVE OR _source STREQUAL _original)
      list(APPEND _mapped "${_copy}")
      math(EXPR _count "${_count}+1")
    else()
      list(APPEND _mapped "${_source}")
    endif()
  endforeach()
  if(NOT _count EQUAL 1)
    message(FATAL_ERROR "DSV41 compile source is no longer unique: ${RELATIVE}")
  endif()
  set_property(TARGET ${TARGET} PROPERTY SOURCES "${_mapped}")
endfunction()

file(READ "${STRATA_CORE_SOURCE}/src/dsv41/vendor/moe_win.cu" _descriptor)
string(REPLACE "\r\n" "\n" _descriptor "${_descriptor}")
_dsv_replace_once(_descriptor "${_descriptor}" "const __grid_constant__ MoeWin w" "const STRATA_DSV_GRID_CONSTANT MoeWin w")
set(_qualifier "#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= 700 && __CUDACC_VER_MAJOR__ >= 12\n#define STRATA_DSV_GRID_CONSTANT __grid_constant__\n#else\n#define STRATA_DSV_GRID_CONSTANT\n#endif\n")
_dsv_compile_copy(strata_dsv41_kernels "src/dsv41/vendor/moe_win.cu"
  "9ddae29b4814c808733db7851db51e4c5806f017d610d1be479a2a41ee0a896e" "${_qualifier}${_descriptor}")

function(_dsv_tensor_core_copy RELATIVE EXPECTED KERNEL END_MARKER HOST_GUARD)
  file(READ "${STRATA_CORE_SOURCE}/${RELATIVE}" _body)
  string(REPLACE "\r\n" "\n" _body "${_body}")
  string(FIND "${_body}" "${HOST_GUARD}" _runtime_guard)
  if(_runtime_guard LESS 0)
    message(FATAL_ERROR "DSV41 tensor-core host guard changed; an empty Pascal stub must remain unreachable")
  endif()
  set(_feature "#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= 700\n")
  _dsv_replace_once(_body "${_body}" "namespace wm = nvcuda::wmma;" "${_feature}namespace wm = nvcuda::wmma;\n#endif")
  _dsv_replace_once(_body "${_body}" "${KERNEL}" "${KERNEL}${_feature}")
  _dsv_replace_once(_body "${_body}" "${END_MARKER}" "\n#endif${END_MARKER}")
  _dsv_compile_copy(strata-dsv41 "${RELATIVE}" "${EXPECTED}" "${_body}")
endfunction()

